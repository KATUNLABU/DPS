---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import ContactEngineering from '../components/ContactEngineering.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="Fale com um Especialista - KATUN DPS Brasil & América Latina"
  description="Entre em contato com a equipe de especialistas da Katun DPS. Cotações, amostras físicas impressas e agendamento de demonstrações."
>
  <Header />

  <main class="pt-20 pb-12 bg-slate-50">
    <!-- Header Hero Banner for Contact Page -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-4 text-center">
      <span class="font-['Space_Grotesk',monospace] text-xs font-bold px-3.5 py-1.5 bg-[#00aeef]/10 text-[#00aeef] inline-block mb-3 uppercase tracking-wider rounded-none">
        ATENDIMENTO AO CLIENTE & ESPECIALISTAS KATUN DPS
      </span>
      <h1 class="font-['Plus_Jakarta_Sans',sans-serif] text-4xl sm:text-5xl font-extrabold text-slate-900 tracking-tight mb-4">
        Fale com um Especialista Katun DPS
      </h1>
      <p class="text-slate-600 max-w-2xl mx-auto text-sm sm:text-base font-['Space_Grotesk',monospace] leading-relaxed">
        Nossa equipe técnica e comercial está à disposição para avaliar suas demandas de impressão digital de rótulos, cotar prensas Memjet® ou troqueladoras e enviar pacotes de amostras físicas.
      </p>
    </div>

    <!-- Contact Info Cards -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        
        <!-- Card 1: Brazil Direct Lead (Cassio Rodrigues) -->
        <div class="bg-white p-6 border-2 border-[#00aeef] shadow-xs flex flex-col justify-between space-y-4 rounded-none">
          <div class="space-y-2">
            <div class="w-10 h-10 bg-[#00aeef]/10 text-[#00aeef] flex items-center justify-center rounded-none font-bold">
              <span class="material-symbols-outlined">call</span>
            </div>
            <div class="flex items-center gap-1.5">
              <span class="text-lg">🇧🇷</span>
              <h3 class="font-['Plus_Jakarta_Sans',sans-serif] text-lg font-bold text-slate-900">
                Atendimento Brasil
              </h3>
            </div>
            <p class="text-xs text-slate-500 font-['Space_Grotesk',monospace] leading-relaxed">
              Assessoria técnica e comercial direta com o especialista da divisão Katun DPS Brasil.
            </p>
          </div>
          <div class="pt-4 border-t border-slate-100 font-['Space_Grotesk',monospace] text-xs space-y-1">
            <span class="text-slate-400 block font-semibold">ENG. CÁSSIO RODRIGUES, MBA:</span>
            <a href="https://wa.me/5511945222069" target="_blank" rel="noopener" class="text-[#00aeef] font-bold hover:underline flex items-center gap-1 mt-0.5">
              WhatsApp: +55 (11) 94522-2069 <span class="material-symbols-outlined text-xs">open_in_new</span>
            </a>
            <span class="text-slate-600 block">Fixo: +55 (11) 3647-3284</span>
            <a href="mailto:cassio.rodrigues@katun.com" class="text-slate-600 hover:text-[#00aeef] block">cassio.rodrigues@katun.com</a>
          </div>
        </div>

        <!-- Card 2: Showroom & Testes -->
        <div class="bg-white p-6 border border-slate-200 shadow-xs flex flex-col justify-between space-y-4 hover:border-[#00aeef] transition-colors rounded-none">
          <div class="space-y-2">
            <div class="w-10 h-10 bg-[#e11d48]/10 text-[#e11d48] flex items-center justify-center rounded-none font-bold">
              <span class="material-symbols-outlined">storefront</span>
            </div>
            <h3 class="font-['Plus_Jakarta_Sans',sans-serif] text-lg font-bold text-slate-900">
              Demonstrações Práticas
            </h3>
            <p class="text-xs text-slate-500 font-['Space_Grotesk',monospace] leading-relaxed">
              Testes de impressão e acabamento ao vivo com seus próprios arquivos vetoriais e substratos reais.
            </p>
          </div>
          <div class="pt-4 border-t border-slate-100 font-['Space_Grotesk',monospace] text-xs space-y-1">
            <span class="text-slate-400 block font-semibold">DISPONIBILIDADE:</span>
            <span class="text-slate-900 font-bold block">Segunda a Sexta (09:00 - 18:00 hrs)</span>
            <span class="text-slate-500 block">Agendamento prévio com nossa equipe técnica</span>
          </div>
        </div>

        <!-- Card 3: Mexico Regional Contact (Obed Guardado) -->
        <div class="bg-white p-6 border border-slate-200 shadow-xs flex flex-col justify-between space-y-4 hover:border-[#00aeef] transition-colors rounded-none">
          <div class="space-y-2">
            <div class="w-10 h-10 bg-[#f59e0b]/10 text-[#f59e0b] flex items-center justify-center rounded-none font-bold">
              <span class="material-symbols-outlined">public</span>
            </div>
            <div class="flex items-center gap-1.5">
              <span class="text-lg">🇲🇽</span>
              <h3 class="font-['Plus_Jakarta_Sans',sans-serif] text-lg font-bold text-slate-900">
                Atendimento México & Norte
              </h3>
            </div>
            <p class="text-xs text-slate-500 font-['Space_Grotesk',monospace] leading-relaxed">
              Suporte comercial e Showroom Experience Center da Katun DPS no México.
            </p>
          </div>
          <div class="pt-4 border-t border-slate-100 font-['Space_Grotesk',monospace] text-xs space-y-1">
            <span class="text-slate-400 block font-semibold">OBED GUARDADO (PROJECT LEADER):</span>
            <a href="https://wa.me/5214492133887" target="_blank" rel="noopener" class="text-slate-700 font-bold hover:text-[#00aeef] flex items-center gap-1 mt-0.5">
              +52 1 (449) 213 3887 <span class="material-symbols-outlined text-xs">open_in_new</span>
            </a>
            <span class="text-slate-500 block">Showroom: Benito Juárez, CDMX</span>
          </div>
        </div>

      </div>
    </div>

    <!-- Contact Form Section -->
    <ContactEngineering />
  </main>

  <Footer />
</Layout>
