---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getIndustries } from '../lib/supabase';
import { MACHINES } from '../data/machines';

const industries = await getIndustries();
---

<Layout 
  title="Soluciones por Sector Industrial - KATUN DPS"
  description="Tecnología de impresión digital de etiquetas y empaques flexibles para bebidas, quimicos GHS, alimentos, farmacéutica, gráfica y fabricación industrial."
>
  <Header />

  <main class="pt-20 pb-20 bg-slate-50 min-h-screen">
    <!-- Hero Banner -->
    <section class="bg-gradient-to-b from-slate-900 via-slate-900 to-slate-950 text-white py-16 sm:py-20 px-4 sm:px-6 lg:px-8 border-b border-slate-800 relative overflow-hidden">
      <!-- Background CMYK Decorative Gradients -->
      <div class="absolute -top-32 -left-32 w-96 h-96 bg-[#00aeef]/20 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-32 -right-32 w-96 h-96 bg-[#e11d48]/20 rounded-full blur-3xl pointer-events-none"></div>

      <div class="max-w-7xl mx-auto text-center relative z-10">
        <span class="font-['Space_Grotesk',monospace] text-xs font-bold px-3.5 py-1.5 bg-[#00aeef]/20 text-[#00aeef] border border-[#00aeef]/30 inline-block mb-4 uppercase tracking-widest">
          TECNOLOGÍA DE ADAPTACIÓN SECTORIAL
        </span>
        <h1 class="font-['Plus_Jakarta_Sans',sans-serif] text-4xl sm:text-6xl font-extrabold text-white tracking-tight mb-6 leading-tight">
          Soluciones de Impresión para <br/>
          <span class="bg-gradient-to-r from-[#00aeef] via-[#f59e0b] to-[#e11d48] bg-clip-text text-transparent">
            Cada Industria Especifica
          </span>
        </h1>
        <p class="text-slate-300 max-w-3xl mx-auto text-sm sm:text-base font-['Space_Grotesk',monospace] leading-relaxed">
          Desde tirajes cortos bajo demanda para microcervecerías hasta etiquetas químicas BS5609 con máxima durabilidad y empaques flexibles en bolsas Mylar. Conéctate con la prensa digital exacta para tu sector.
        </p>

        <!-- Quick Filter Badges / Navigation Tabs -->
        <div class="mt-10 flex flex-wrap justify-center gap-2 max-w-5xl mx-auto">
          {industries.map((ind, idx) => (
            <a 
              href={`#${ind.slug}`} 
              class="bg-slate-800/80 hover:bg-[#00aeef] hover:text-white border border-slate-700/80 text-slate-200 text-xs font-['Space_Grotesk',monospace] px-4 py-2 transition-all duration-200 flex items-center gap-2 group shadow-sm"
            >
              <span class="material-symbols-outlined text-sm text-[#00aeef] group-hover:text-white">{ind.icon}</span>
              <span>{ind.title}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Industry Deep-Dive Cards Section -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-16">
      {industries.map((ind, index) => (
        <section 
          id={ind.slug} 
          class={`bg-white border border-slate-200 shadow-md overflow-hidden relative transition-all duration-300 scroll-mt-24 ${index % 2 === 1 ? 'lg:flex-row-reverse' : ''}`}
        >
          <!-- Accent Top Bar -->
          <div class="h-1.5 w-full bg-gradient-to-r from-[#00aeef] via-[#f59e0b] to-[#e11d48]"></div>

          <div class="grid grid-cols-1 lg:grid-cols-12 gap-0">
            
            <!-- Left Image & Banner Panel -->
            <div class="lg:col-span-5 relative min-h-[300px] lg:min-h-full bg-slate-900 overflow-hidden">
              <img 
                src={ind.image} 
                alt={ind.title} 
                class="w-full h-full object-cover opacity-85 hover:scale-105 transition-transform duration-700"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950/90 via-slate-950/40 to-transparent"></div>
              
              <div class="absolute top-4 left-4">
                <span class="bg-slate-900/90 backdrop-blur-md text-white text-[10px] font-['Space_Grotesk',monospace] font-bold px-3 py-1 border border-slate-700 tracking-wider">
                  {ind.tag}
                </span>
              </div>

              <div class="absolute bottom-6 left-6 right-6 text-white space-y-2">
                <div class="flex items-center gap-2 text-[#00aeef]">
                  <span class="material-symbols-outlined text-3xl">{ind.icon}</span>
                  <span class="font-['Space_Grotesk',monospace] text-xs font-bold uppercase tracking-wider">SECTOR #{index + 1}</span>
                </div>
                <h2 class="font-['Plus_Jakarta_Sans',sans-serif] text-2xl sm:text-3xl font-extrabold text-white">
                  {ind.title}
                </h2>
              </div>
            </div>

            <!-- Right Content Panel -->
            <div class="lg:col-span-7 p-6 sm:p-10 flex flex-col justify-between space-y-6">
              
              <!-- Main Description -->
              <div class="space-y-4">
                <h3 class="font-['Plus_Jakarta_Sans',sans-serif] text-xl font-bold text-slate-900 border-b border-slate-100 pb-3 flex items-center gap-2">
                  <span class="w-2 h-2 bg-[#00aeef] inline-block"></span>
                  Requerimientos y Ventajas Competitivas
                </h3>
                
                <p class="text-slate-700 text-sm sm:text-base leading-relaxed font-['Space_Grotesk',monospace]">
                  {ind.description}
                </p>
              </div>

              <!-- Subsections / Tags Highlights -->
              {ind.subsections && ind.subsections.length > 0 && (
                <div class="space-y-3 bg-slate-50 p-4 border border-slate-200">
                  <span class="font-['Space_Grotesk',monospace] text-xs font-bold text-slate-500 uppercase tracking-wider block">
                    ESPECIALIDADES DESTACADAS DEL SECTOR:
                  </span>
                  <div class="flex flex-wrap gap-2">
                    {ind.subsections.map(sub => (
                      <span class="bg-white border border-slate-300 text-slate-800 font-['Space_Grotesk',monospace] text-xs font-semibold px-3 py-1 flex items-center gap-1.5 shadow-xs">
                        <span class="material-symbols-outlined text-xs text-[#00aeef]">check_circle</span>
                        {sub}
                      </span>
                    ))}
                  </div>
                </div>
              )}

              <!-- Recommended Machines per Industry -->
              {ind.recommendedMachines && ind.recommendedMachines.length > 0 && (
                <div class="space-y-3 pt-2">
                  <span class="font-['Space_Grotesk',monospace] text-xs font-bold text-slate-900 uppercase tracking-wider block">
                    TECNOLOGÍA RECOMENDADA DE KATUN DPS:
                  </span>
                  <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                    {ind.recommendedMachines.map(machineName => {
                      const foundMachine = MACHINES.find(m => m.name.toLowerCase().includes(machineName.toLowerCase()) || machineName.toLowerCase().includes(m.name.toLowerCase()));
                      return (
                        <a 
                          href={foundMachine ? `/catalogo#${foundMachine.id}` : '/catalogo'}
                          class="bg-white border border-slate-200 p-3 hover:border-[#00aeef] transition-colors group flex flex-col justify-between"
                        >
                          <div class="font-['Plus_Jakarta_Sans',sans-serif] text-xs font-bold text-slate-900 group-hover:text-[#00aeef] transition-colors">
                            {machineName}
                          </div>
                          <div class="mt-2 text-[10px] text-slate-500 font-['Space_Grotesk',monospace] flex items-center gap-1">
                            Ver Especificaciones <span class="material-symbols-outlined text-[12px] group-hover:translate-x-0.5 transition-transform">arrow_forward</span>
                          </div>
                        </a>
                      );
                    })}
                  </div>
                </div>
              )}

              <!-- Action Bar -->
              <div class="pt-4 border-t border-slate-200 flex flex-wrap items-center justify-between gap-4">
                <a 
                  href={`https://wa.me/5215580793969?text=Hola,%20me%20interesa%20obtener%20asesoría%20y%20cotización%20para%20la%20${encodeURIComponent(ind.title)}`}
                  target="_blank" 
                  rel="noopener" 
                  class="bg-slate-900 hover:bg-[#00aeef] text-white text-xs font-bold font-['Space_Grotesk',monospace] px-5 py-3 transition-colors flex items-center gap-2 shadow-xs"
                >
                  <span class="material-symbols-outlined text-base">chat</span>
                  COTIZAR SOLUCIÓN PARA {ind.title.toUpperCase()}
                </a>

                <a 
                  href="/contacto" 
                  class="text-xs font-bold text-slate-600 hover:text-[#00aeef] font-['Space_Grotesk',monospace] flex items-center gap-1 transition-colors"
                >
                  SOLICITAR PRUEBA DE IMPRESIÓN SIN COSTO <span class="material-symbols-outlined text-sm">navigate_next</span>
                </a>
              </div>

            </div>

          </div>
        </section>
      ))}
    </div>

    <!-- Bottom CTA Banner -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-12">
      <div class="bg-gradient-to-r from-slate-900 via-slate-850 to-slate-900 border border-slate-800 p-8 sm:p-12 text-white flex flex-col md:flex-row items-center justify-between gap-8 shadow-xl">
        <div class="space-y-3 text-center md:text-left">
          <span class="font-['Space_Grotesk',monospace] text-xs font-bold text-[#00aeef] uppercase tracking-wider">
            ¿NO ENCUENTRAS TU APLICACIÓN ESPECÍFICA?
          </span>
          <h2 class="font-['Plus_Jakarta_Sans',sans-serif] text-2xl sm:text-3xl font-extrabold text-white">
            Desarrollamos Soluciones a Medida In-House
          </h2>
          <p class="text-slate-300 text-xs sm:text-sm max-w-xl font-['Space_Grotesk',monospace]">
            Nuestros ingenieros evalúan tu sustrato, resistencia química requerida y volumen de producción para recomendar la combinación ideal de prensa y acabador láser.
          </p>
        </div>

        <div class="flex flex-col sm:flex-row gap-4 w-full md:w-auto">
          <a 
            href="/contacto" 
            class="bg-[#00aeef] hover:bg-[#0096d1] text-white text-xs font-bold font-['Space_Grotesk',monospace] px-6 py-3.5 text-center transition-all shadow-md uppercase tracking-wider"
          >
            Agendar Asesoría Técnica
          </a>
          <a 
            href="/catalogo" 
            class="border border-slate-700 hover:bg-slate-800 text-slate-200 text-xs font-bold font-['Space_Grotesk',monospace] px-6 py-3.5 text-center transition-all uppercase tracking-wider"
          >
            Explorar Prensas y Cortadoras
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
