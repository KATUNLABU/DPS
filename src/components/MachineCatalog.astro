---
import { getMachines } from '../lib/vultr-db';

const allMachines = await getMachines();
const impresoras = allMachines.filter(m => m.category === 'impresoras');
const cortadoras = allMachines.filter(m => m.category === 'cortadoras');
const especiales = allMachines.filter(m => m.category === 'especiales');
---

<section id="catalog" class="py-16 sm:py-24 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto border-t border-slate-200">
  <!-- Header Title -->
  <div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-6 mb-12">
    <div class="space-y-3">
      <span class="font-['Space_Grotesk',monospace] text-xs font-semibold px-3.5 py-1.5 bg-slate-900 text-white inline-block rounded-none uppercase">
        CATÁLOGO OFICIAL 2025 - 2026
      </span>
      <h2 class="font-['Plus_Jakarta_Sans',sans-serif] text-3xl sm:text-5xl font-extrabold text-slate-900 tracking-tight">
        Catálogo de Equipamentos ({allMachines.length})
      </h2>
    </div>
    <p class="max-w-md text-slate-600 text-sm leading-relaxed font-['Space_Grotesk',monospace]">
      Linha industrial completa: prensas digitais inkjet Memjet® DuraFlex, troqueladoras a laser CO2, lâminas tangenciais e contadores automáticos Katun DPS.
    </p>
  </div>

  <!-- Filter Buttons & Search Bar -->
  <div class="flex flex-col lg:flex-row gap-4 justify-between items-stretch lg:items-center mb-10">
    <!-- Filter Tabs (Square) -->
    <div class="flex flex-wrap gap-2" id="category-filters">
      <button 
        data-category="all" 
        class="cat-filter-btn px-4 py-2 font-['Space_Grotesk',monospace] text-xs font-bold bg-slate-900 text-white shadow-xs transition-all cursor-crosshair rounded-none uppercase"
      >
        TODOS OS EQUIPAMENTOS ({allMachines.length})
      </button>
      <button 
        data-category="impresoras" 
        class="cat-filter-btn px-4 py-2 font-['Space_Grotesk',monospace] text-xs font-medium bg-white text-slate-600 border border-slate-200 hover:bg-slate-100 transition-all cursor-crosshair rounded-none uppercase"
      >
        EQUIPAMENTOS INKJET ({impresoras.length})
      </button>
      <button 
        data-category="cortadoras" 
        class="cat-filter-btn px-4 py-2 font-['Space_Grotesk',monospace] text-xs font-medium bg-white text-slate-600 border border-slate-200 hover:bg-slate-100 transition-all cursor-crosshair rounded-none uppercase"
      >
        CORTADORAS E FINALIZADORAS ({cortadoras.length})
      </button>
      <button 
        data-category="especiales" 
        class="cat-filter-btn px-4 py-2 font-['Space_Grotesk',monospace] text-xs font-medium bg-white text-slate-600 border border-slate-200 hover:bg-slate-100 transition-all cursor-crosshair rounded-none uppercase"
      >
        CONTADOR ROLO A ROLO ({especiales.length})
      </button>
    </div>

    <!-- Live Search Bar -->
    <div class="relative w-full lg:w-80">
      <span class="material-symbols-outlined absolute left-3.5 top-2.5 text-slate-400 text-sm">search</span>
      <input 
        type="text" 
        id="search-input" 
        placeholder="Buscar equipamento ou tecnologia..." 
        class="w-full pl-10 pr-4 py-2 text-xs bg-white border border-slate-200 focus:ring-2 focus:ring-[#00aeef] focus:outline-none placeholder:text-slate-400 font-['Space_Grotesk',monospace] rounded-none cursor-crosshair"
      />
    </div>
  </div>

  <!-- ═══════════════════════════════════════════════════ -->
  <!-- SEÇÃO 1: EQUIPAMENTOS INKJET                        -->
  <!-- ═══════════════════════════════════════════════════ -->
  <div class="catalog-section mb-16" data-section="impresoras">
    <div class="flex items-center gap-4 mb-8 pb-3 border-b-2 border-[#00aeef]">
      <div class="w-10 h-10 bg-[#00aeef] flex items-center justify-center rounded-none">
        <span class="material-symbols-outlined text-xl text-white">print</span>
      </div>
      <div>
        <h3 class="font-['Plus_Jakarta_Sans',sans-serif] text-2xl font-extrabold text-slate-900 tracking-tight uppercase">
          EQUIPAMENTOS INKJET
        </h3>
        <span class="font-['Space_Grotesk',monospace] text-xs font-semibold text-[#00aeef] uppercase">
          {impresoras.length} EQUIPAMENTOS • MEMJET® DURAFLEX® • TINTAS PIGMENTADAS • LED HD • PIEZOELÉTRICO UV
        </span>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="machines-grid-impresoras">
      {impresoras.map((machine) => (
        <article 
          class="machine-card bg-white border border-slate-200 shadow-xs hover:shadow-xl transition-all duration-300 flex flex-col justify-between group rounded-none"
          data-category={machine.category}
          data-name={machine.name.toLowerCase()}
          data-tech={machine.technology.toLowerCase()}
        >
          <div>
            <!-- Machine Image Container -->
            <div class="relative h-48 sm:h-52 overflow-hidden bg-slate-100 rounded-none p-2 flex items-center justify-center">
              <img 
                src={machine.image} 
                alt={machine.name} 
                class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-500"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-900/40 via-transparent to-transparent pointer-events-none"></div>

              <span class="absolute top-3 left-3 bg-white/90 backdrop-blur-md text-slate-900 text-[10px] font-['Space_Grotesk',monospace] font-bold px-2.5 py-1 shadow-xs rounded-none border border-slate-200 uppercase">
                EQUIPAMENTO INKJET
              </span>

              {machine.badge && (
                <span class="absolute top-3 right-3 bg-[#00aeef] text-white text-[10px] font-['Space_Grotesk',monospace] font-bold px-2.5 py-1 shadow-xs rounded-none uppercase">
                  {machine.badge}
                </span>
              )}
            </div>

            <!-- Machine Body Info -->
            <div class="p-6 space-y-4">
              <div>
                <h3 class="font-['Plus_Jakarta_Sans',sans-serif] text-xl font-bold text-slate-900 group-hover:text-[#00aeef] transition-colors">
                  {machine.name}
                </h3>
                <p class="font-['Space_Grotesk',monospace] text-xs text-slate-500 mt-1 line-clamp-2">
                  {machine.subtitle}
                </p>
              </div>

              <!-- Key Specs Pill Table -->
              <div class="grid grid-cols-2 gap-2 p-3 bg-slate-50 border border-slate-100 text-[11px] font-['Space_Grotesk',monospace] rounded-none">
                <div>
                  <span class="text-slate-400 block text-[10px]">TECNOLOGIA</span>
                  <span class="font-semibold text-slate-800 truncate block">{machine.technology}</span>
                </div>
                <div>
                  <span class="text-slate-400 block text-[10px]">VELOCIDADE</span>
                  <span class="font-semibold text-[#00aeef] truncate block">{machine.speed}</span>
                </div>
                <div>
                  <span class="text-slate-400 block text-[10px]">RESOLUÇÃO</span>
                  <span class="font-semibold text-slate-800 truncate block">{machine.resolution}</span>
                </div>
                <div>
                  <span class="text-slate-400 block text-[10px]">LARGURA MÁX</span>
                  <span class="font-semibold text-slate-800 truncate block">{machine.maxWidth}</span>
                </div>
              </div>

              <p class="text-xs text-slate-600 leading-relaxed line-clamp-2 font-['Space_Grotesk',monospace]">
                {machine.description}
              </p>
            </div>
          </div>

          <!-- Card Actions -->
          <div class="px-6 pb-6 pt-2 flex flex-col gap-2">
            <a 
              href={`https://wa.me/5511945222069?text=Ol%C3%A1%20C%C3%A1ssio%2C%20tenho%20interesse%20em%20uma%20cota%C3%A7%C3%A3o%20do%20equipamento%20${encodeURIComponent(machine.name)}`}
              target="_blank"
              rel="noopener"
              class="w-full bg-[#00aeef] hover:bg-[#0096d1] text-white text-xs font-bold py-2.5 px-3 transition-colors flex items-center justify-center gap-1.5 cursor-crosshair shadow-xs rounded-none uppercase font-['Space_Grotesk',monospace]"
            >
              <span class="material-symbols-outlined text-sm">chat</span>
              <span>COTAR COM CÁSSIO (WHATSAPP)</span>
            </a>

            <div class="flex gap-2">
              <a 
                href={`/solucion/${machine.id}`}
                class="flex-1 bg-slate-900 hover:bg-slate-800 text-white text-xs font-semibold py-2.5 px-3 transition-colors flex items-center justify-center gap-1 cursor-crosshair shadow-xs rounded-none font-['Space_Grotesk',monospace] uppercase"
                title="Detalhes Técnicos"
              >
                <span>DETALHES</span>
                <span class="material-symbols-outlined text-xs">arrow_forward</span>
              </a>

              <button 
                class="open-modal-btn px-3 bg-slate-100 hover:bg-slate-200 text-slate-800 text-xs font-semibold py-2.5 transition-colors flex items-center justify-center gap-1 cursor-crosshair rounded-none"
                data-id={machine.id}
                title="Visualização Rápida"
              >
                <span class="material-symbols-outlined text-sm">visibility</span>
              </button>

              <a 
                href={machine.pdfUrl} 
                target="_blank" 
                rel="noopener"
                class="bg-slate-100 hover:bg-slate-200 text-slate-800 text-xs font-semibold py-2.5 px-3 transition-colors flex items-center justify-center gap-1 cursor-crosshair rounded-none uppercase font-['Space_Grotesk',monospace]"
                title="Baixar Ficha Técnica em PDF"
              >
                <span class="material-symbols-outlined text-sm text-rose-500">picture_as_pdf</span>
                <span>PDF</span>
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>

  <!-- ═══════════════════════════════════════════════════ -->
  <!-- SEÇÃO 2: CORTADORAS E FINALIZADORAS                 -->
  <!-- ═══════════════════════════════════════════════════ -->
  <div class="catalog-section mb-16" data-section="cortadoras">
    <div class="flex items-center gap-4 mb-8 pb-3 border-b-2 border-[#e11d48]">
      <div class="w-10 h-10 bg-[#e11d48] flex items-center justify-center rounded-none">
        <span class="material-symbols-outlined text-xl text-white">content_cut</span>
      </div>
      <div>
        <h3 class="font-['Plus_Jakarta_Sans',sans-serif] text-2xl font-extrabold text-slate-900 tracking-tight uppercase">
          CORTADORAS E FINALIZADORAS DE RÓTULOS
        </h3>
        <span class="font-['Space_Grotesk',monospace] text-xs font-semibold text-[#e11d48] uppercase">
          {cortadoras.length} EQUIPAMENTOS • LÂMINA TANGENCIAL • CORTE A LASER CO2 • MULTI-LÂMINAS • EM FOLHA B3
        </span>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="machines-grid-cortadoras">
      {cortadoras.map((machine) => (
        <article 
          class="machine-card bg-white border border-slate-200 shadow-xs hover:shadow-xl transition-all duration-300 flex flex-col justify-between group rounded-none"
          data-category={machine.category}
          data-name={machine.name.toLowerCase()}
          data-tech={machine.technology.toLowerCase()}
        >
          <div>
            <div class="relative h-48 sm:h-52 overflow-hidden bg-slate-100 rounded-none p-2 flex items-center justify-center">
              <img 
                src={machine.image} 
                alt={machine.name} 
                class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-500"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-900/40 via-transparent to-transparent pointer-events-none"></div>

              <span class="absolute top-3 left-3 bg-white/90 backdrop-blur-md text-slate-900 text-[10px] font-['Space_Grotesk',monospace] font-bold px-2.5 py-1 shadow-xs rounded-none border border-slate-200 uppercase">
                CORTADORA / FINALIZADORA
              </span>

              {machine.badge && (
                <span class="absolute top-3 right-3 bg-[#e11d48] text-white text-[10px] font-['Space_Grotesk',monospace] font-bold px-2.5 py-1 shadow-xs rounded-none uppercase">
                  {machine.badge}
                </span>
              )}
            </div>

            <div class="p-6 space-y-4">
              <div>
                <h3 class="font-['Plus_Jakarta_Sans',sans-serif] text-xl font-bold text-slate-900 group-hover:text-[#e11d48] transition-colors">
                  {machine.name}
                </h3>
                <p class="font-['Space_Grotesk',monospace] text-xs text-slate-500 mt-1 line-clamp-2">
                  {machine.subtitle}
                </p>
              </div>

              <div class="grid grid-cols-2 gap-2 p-3 bg-slate-50 border border-slate-100 text-[11px] font-['Space_Grotesk',monospace] rounded-none">
                <div>
                  <span class="text-slate-400 block text-[10px]">TECNOLOGIA</span>
                  <span class="font-semibold text-slate-800 truncate block">{machine.technology}</span>
                </div>
                <div>
                  <span class="text-slate-400 block text-[10px]">VELOCIDADE</span>
                  <span class="font-semibold text-[#e11d48] truncate block">{machine.speed}</span>
                </div>
                <div>
                  <span class="text-slate-400 block text-[10px]">PRECISÃO</span>
                  <span class="font-semibold text-slate-800 truncate block">{machine.resolution}</span>
                </div>
                <div>
                  <span class="text-slate-400 block text-[10px]">LARGURA MÁX</span>
                  <span class="font-semibold text-slate-800 truncate block">{machine.maxWidth}</span>
                </div>
              </div>

              <p class="text-xs text-slate-600 leading-relaxed line-clamp-2 font-['Space_Grotesk',monospace]">
                {machine.description}
              </p>
            </div>
          </div>

          <div class="px-6 pb-6 pt-2 flex flex-col gap-2">
            <a 
              href={`https://wa.me/5511945222069?text=Ol%C3%A1%20C%C3%A1ssio%2C%20tenho%20interesse%20em%20uma%20cota%C3%A7%C3%A3o%20do%20equipamento%20${encodeURIComponent(machine.name)}`}
              target="_blank"
              rel="noopener"
              class="w-full bg-[#e11d48] hover:bg-[#be123c] text-white text-xs font-bold py-2.5 px-3 transition-colors flex items-center justify-center gap-1.5 cursor-crosshair shadow-xs rounded-none uppercase font-['Space_Grotesk',monospace]"
            >
              <span class="material-symbols-outlined text-sm">chat</span>
              <span>COTAR COM CÁSSIO (WHATSAPP)</span>
            </a>

            <div class="flex gap-2">
              <a 
                href={`/solucion/${machine.id}`}
                class="flex-1 bg-slate-900 hover:bg-slate-800 text-white text-xs font-semibold py-2.5 px-3 transition-colors flex items-center justify-center gap-1 cursor-crosshair shadow-xs rounded-none font-['Space_Grotesk',monospace] uppercase"
                title="Detalhes Técnicos"
              >
                <span>DETALHES</span>
                <span class="material-symbols-outlined text-xs">arrow_forward</span>
              </a>

              <button 
                class="open-modal-btn px-3 bg-slate-100 hover:bg-slate-200 text-slate-800 text-xs font-semibold py-2.5 transition-colors flex items-center justify-center gap-1 cursor-crosshair rounded-none"
                data-id={machine.id}
                title="Visualização Rápida"
              >
                <span class="material-symbols-outlined text-sm">visibility</span>
              </button>

              <a 
                href={machine.pdfUrl} 
                target="_blank" 
                rel="noopener"
                class="bg-slate-100 hover:bg-slate-200 text-slate-800 text-xs font-semibold py-2.5 px-3 transition-colors flex items-center justify-center gap-1 cursor-crosshair rounded-none uppercase font-['Space_Grotesk',monospace]"
                title="Baixar Ficha Técnica em PDF"
              >
                <span class="material-symbols-outlined text-sm text-rose-500">picture_as_pdf</span>
                <span>PDF</span>
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>

  <!-- ═══════════════════════════════════════════════════ -->
  <!-- SEÇÃO 3: CONTADOR DE RÓTULOS AUTOMÁTICO             -->
  <!-- ═══════════════════════════════════════════════════ -->
  <div class="catalog-section mb-20" data-section="especiales">
    <div class="flex items-center gap-4 mb-8 pb-3 border-b-2 border-[#f59e0b]">
      <div class="w-10 h-10 bg-[#f59e0b] flex items-center justify-center rounded-none">
        <span class="material-symbols-outlined text-xl text-white">fact_check</span>
      </div>
      <div>
        <h3 class="font-['Plus_Jakarta_Sans',sans-serif] text-2xl font-extrabold text-slate-900 tracking-tight uppercase">
          CONTADOR AUTOMÁTICO DE RÓTULOS ROLO A ROLO
        </h3>
        <span class="font-['Space_Grotesk',monospace] text-xs font-semibold text-[#f59e0b] uppercase">
          {especiales.length} EQUIPAMENTO • SENSOR ULTRASSÔNICO & FOTOELÉTRICO • CONTAGEM EM ALTA VELOCIDADE
        </span>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="machines-grid-especiales">
      {especiales.map((machine) => (
        <article 
          class="machine-card bg-white border border-slate-200 shadow-xs hover:shadow-xl transition-all duration-300 flex flex-col justify-between group rounded-none"
          data-category={machine.category}
          data-name={machine.name.toLowerCase()}
          data-tech={machine.technology.toLowerCase()}
        >
          <div>
            <div class="relative h-48 sm:h-52 overflow-hidden bg-slate-100 rounded-none p-2 flex items-center justify-center">
              <img 
                src={machine.image} 
                alt={machine.name} 
                class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-500"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-900/40 via-transparent to-transparent pointer-events-none"></div>

              <span class="absolute top-3 left-3 bg-white/90 backdrop-blur-md text-slate-900 text-[10px] font-['Space_Grotesk',monospace] font-bold px-2.5 py-1 shadow-xs rounded-none border border-slate-200 uppercase">
                CONTADOR ROLO A ROLO
              </span>

              {machine.badge && (
                <span class="absolute top-3 right-3 bg-[#f59e0b] text-white text-[10px] font-['Space_Grotesk',monospace] font-bold px-2.5 py-1 shadow-xs rounded-none uppercase">
                  {machine.badge}
                </span>
              )}
            </div>

            <div class="p-6 space-y-4">
              <div>
                <h3 class="font-['Plus_Jakarta_Sans',sans-serif] text-xl font-bold text-slate-900 group-hover:text-[#f59e0b] transition-colors">
                  {machine.name}
                </h3>
                <p class="font-['Space_Grotesk',monospace] text-xs text-slate-500 mt-1 line-clamp-2">
                  {machine.subtitle}
                </p>
              </div>

              <div class="grid grid-cols-2 gap-2 p-3 bg-slate-50 border border-slate-100 text-[11px] font-['Space_Grotesk',monospace] rounded-none">
                <div>
                  <span class="text-slate-400 block text-[10px]">TECNOLOGIA</span>
                  <span class="font-semibold text-slate-800 truncate block">{machine.technology}</span>
                </div>
                <div>
                  <span class="text-slate-400 block text-[10px]">VELOCIDADE</span>
                  <span class="font-semibold text-[#f59e0b] truncate block">{machine.speed}</span>
                </div>
                <div>
                  <span class="text-slate-400 block text-[10px]">PRECISÃO</span>
                  <span class="font-semibold text-slate-800 truncate block">{machine.resolution}</span>
                </div>
                <div>
                  <span class="text-slate-400 block text-[10px]">LARGURA MÁX</span>
                  <span class="font-semibold text-slate-800 truncate block">{machine.maxWidth}</span>
                </div>
              </div>

              <p class="text-xs text-slate-600 leading-relaxed line-clamp-2 font-['Space_Grotesk',monospace]">
                {machine.description}
              </p>
            </div>
          </div>

          <div class="px-6 pb-6 pt-2 flex flex-col gap-2">
            <a 
              href={`https://wa.me/5511945222069?text=Ol%C3%A1%20C%C3%A1ssio%2C%20tenho%20interesse%20em%20uma%20cota%C3%A7%C3%A3o%20do%20equipamento%20${encodeURIComponent(machine.name)}`}
              target="_blank"
              rel="noopener"
              class="w-full bg-[#f59e0b] hover:bg-[#d97706] text-white text-xs font-bold py-2.5 px-3 transition-colors flex items-center justify-center gap-1.5 cursor-crosshair shadow-xs rounded-none uppercase font-['Space_Grotesk',monospace]"
            >
              <span class="material-symbols-outlined text-sm">chat</span>
              <span>COTAR COM CÁSSIO (WHATSAPP)</span>
            </a>

            <div class="flex gap-2">
              <a 
                href={`/solucion/${machine.id}`}
                class="flex-1 bg-slate-900 hover:bg-slate-800 text-white text-xs font-semibold py-2.5 px-3 transition-colors flex items-center justify-center gap-1 cursor-crosshair shadow-xs rounded-none font-['Space_Grotesk',monospace] uppercase"
                title="Detalhes Técnicos"
              >
                <span>DETALHES</span>
                <span class="material-symbols-outlined text-xs">arrow_forward</span>
              </a>

              <button 
                class="open-modal-btn px-3 bg-slate-100 hover:bg-slate-200 text-slate-800 text-xs font-semibold py-2.5 transition-colors flex items-center justify-center gap-1 cursor-crosshair rounded-none"
                data-id={machine.id}
                title="Visualização Rápida"
              >
                <span class="material-symbols-outlined text-sm">visibility</span>
              </button>

              <a 
                href={machine.pdfUrl} 
                target="_blank" 
                rel="noopener"
                class="bg-slate-100 hover:bg-slate-200 text-slate-800 text-xs font-semibold py-2.5 px-3 transition-colors flex items-center justify-center gap-1 cursor-crosshair rounded-none uppercase font-['Space_Grotesk',monospace]"
                title="Baixar Ficha Técnica em PDF"
              >
                <span class="material-symbols-outlined text-sm text-rose-500">picture_as_pdf</span>
                <span>PDF</span>
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>

  <!-- ═══════════════════════════════════════════════════ -->
  <!-- BANNER: BAIXAR CATÁLOGO OFICIAL KATUN DPS           -->
  <!-- ═══════════════════════════════════════════════════ -->
  <div class="bg-gradient-to-br from-slate-950 via-slate-900 to-slate-950 border-2 border-slate-800 p-8 sm:p-12 text-white relative overflow-hidden shadow-2xl rounded-none mb-8">
    <div class="absolute -right-20 -bottom-20 w-96 h-96 bg-[#00aeef]/10 blur-3xl pointer-events-none rounded-full"></div>
    <div class="absolute -left-20 -top-20 w-80 h-80 bg-[#e11d48]/10 blur-3xl pointer-events-none rounded-full"></div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center relative z-10">
