---
---

<section id="specs" class="py-16 sm:py-24 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto border-t border-slate-200">
  <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
    <span class="font-['Space_Grotesk',monospace] text-xs font-semibold px-3.5 py-1.5 bg-slate-900 text-white inline-block rounded-none">
      TECNOLOGÍA DE PUNTA
    </span>
    <h2 class="font-['Plus_Jakarta_Sans',sans-serif] text-3xl sm:text-5xl font-extrabold text-slate-900 tracking-tight">
      Especificaciones Técnicas & Módulos Industriales
    </h2>
    <p class="text-slate-600 text-sm sm:text-base leading-relaxed font-['Space_Grotesk',monospace]">
      Sistemas de impresión y troquelado diseñados para máxima eficiencia operacional, registro micronométrico y durabilidad certificada.
    </p>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
    <!-- Left Technical Parameters Card (Square) -->
    <div class="lg:col-span-5 bg-white p-6 sm:p-8 border border-slate-200 shadow-sm flex flex-col justify-between space-y-6 rounded-none">
      <div>
        <div class="flex items-center gap-3 mb-6 pb-4 border-b border-slate-100">
          <span class="material-symbols-outlined text-2xl text-[#00aeef]">tune</span>
          <h3 class="font-['Plus_Jakarta_Sans',sans-serif] text-xl font-bold text-slate-900">PARÁMETROS CLAVE</h3>
        </div>

        <div class="space-y-4 font-['Space_Grotesk',monospace] text-xs">
          <div class="flex justify-between items-center py-2 border-b border-slate-100">
            <span class="text-slate-500 font-medium">SUSTRATO MÁXIMO</span>
            <span class="font-bold text-slate-900 bg-slate-100 px-2.5 py-1 rounded-none">350 GSM ARCHIVAL</span>
          </div>

          <div class="flex justify-between items-center py-2 border-b border-slate-100">
            <span class="text-slate-500 font-medium">GAMA DE COLOR</span>
            <span class="font-bold text-[#00aeef] bg-[#00aeef]/10 px-2.5 py-1 rounded-none">EXT CMYK + OGV</span>
          </div>

          <div class="flex justify-between items-center py-2 border-b border-slate-100">
            <span class="text-slate-500 font-medium">SISTEMA DE SECADO</span>
            <span class="font-bold text-[#e11d48] bg-rose-50 px-2.5 py-1 rounded-none">DUAL UV LED ARRAY</span>
          </div>

          <div class="flex justify-between items-center py-2 border-b border-slate-100">
            <span class="text-slate-500 font-medium">MESA DE VACÍO</span>
            <span class="font-bold text-[#f59e0b] bg-amber-50 px-2.5 py-1 rounded-none">MULTI-ZONA SERVO</span>
          </div>

          <div class="flex justify-between items-center py-2 border-b border-slate-100">
            <span class="text-slate-500 font-medium">TECNOLOGÍA CABEZAL</span>
            <span class="font-bold text-slate-900 bg-slate-100 px-2.5 py-1 rounded-none">MEMJET DURAFLEX</span>
          </div>
        </div>
      </div>

      <!-- Notice Banner (Square) -->
      <div class="p-4 bg-slate-50 border border-slate-200/80 text-xs font-['Space_Grotesk',monospace] text-slate-600 rounded-none">
        <span class="font-bold text-slate-900 block mb-1">Garantía de Calibración [+]</span>
        <span>Todos los equipos Katun DPS cuentan con certificación de calibración óptica y soporte técnico presencial en México y Latam.</span>
      </div>
    </div>

    <!-- Right 2 Module Visual Cards (Square) -->
    <div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-6">
      <!-- Laser Cut Module X1 -->
      <div class="bg-white border border-slate-200 overflow-hidden shadow-sm hover:shadow-md transition-shadow group flex flex-col justify-between rounded-none">
        <div class="relative h-56 overflow-hidden rounded-none">
          <img 
            src="https://images.unsplash.com/photo-1504917599217-d4dc5ebe6122?auto=format&fit=crop&w=800&q=80" 
            alt="Módulo de corte láser LC 350 PM" 
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
          />
          <span class="absolute top-3 left-3 bg-[#e11d48] text-white text-[11px] font-['Space_Grotesk',monospace] font-bold px-3 py-1 shadow-sm rounded-none">
            LÁSER CO2 LC 350 PM
          </span>
        </div>
        <div class="p-6 space-y-2">
          <h4 class="font-['Plus_Jakarta_Sans',sans-serif] text-lg font-bold text-slate-900">
            Troquelado Láser Galvo
          </h4>
          <p class="text-xs text-slate-600 leading-relaxed font-['Space_Grotesk',monospace]">
            Unidad de corte digital con velocidad de hasta 80 m/min. Elimina troqueles físicos y permite cambiar de diseño al instante mediante lectura de código QR.
          </p>
        </div>
      </div>

      <!-- CMYK Injection V2 -->
      <div class="bg-white border border-slate-200 overflow-hidden shadow-sm hover:shadow-md transition-shadow group flex flex-col justify-between rounded-none">
        <div class="relative h-56 overflow-hidden rounded-none">
          <img 
            src="https://images.unsplash.com/photo-1562654501-a0ccc0fc3fb1?auto=format&fit=crop&w=800&q=80" 
            alt="Inyección de tinta CMYK Memjet DuraFlex" 
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
          />
          <span class="absolute top-3 left-3 bg-[#00aeef] text-white text-[11px] font-['Space_Grotesk',monospace] font-bold px-3 py-1 shadow-sm rounded-none">
            MEMJET® DURAFLEX
          </span>
        </div>
        <div class="p-6 space-y-2">
          <h4 class="font-['Plus_Jakarta_Sans',sans-serif] text-lg font-bold text-slate-900">
            Micro-Inyección CMYK
          </h4>
          <p class="text-xs text-slate-600 leading-relaxed font-['Space_Grotesk',monospace]">
            Inyección continua a 120kHz con gotas fijas de 1.2 picolitros. Nitidez impecable en textos pequeños de 3pt y códigos de barras de alta densidad.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
