---
const CAPABILITIES = [
  {
    id: "impresion-etiquetas",
    title: "Impressão Digital de Rótulos",
    subtitle: "TECNOLOGIA DURAFLEX® MEMJET®",
    icon: "print",
    description: "Imprime rótulos autoadesivos com cabeçotes de alta velocidade Memjet DuraFlex® a 1600x1600 DPI em passagem única contínua.",
    badge: "MEMJET® DURAFLEX®"
  },
  {
    id: "impresion-bobina",
    title: "Impressão em Bobina & Folha",
    subtitle: "ROLO A ROLO E CORTE EM FOLHA SOLTA",
    icon: "inventory_2",
    description: "Alimentação contínua de bobinas ou folhas soltas para rótulos em materiais sintéticos, papéis couché, BOPP, PET e filmes metalizados.",
    badge: "BOBINA & FOLHA"
  },
  {
    id: "corte-laser",
    title: "Corte: Lâmina Tangencial & Laser CO2",
    subtitle: "CORTE DIGITAL ÓPTICO SEM MATRIZ",
    icon: "content_cut",
    description: "Troquelagem digital por 1 lâmina tangencial de alta precisão, multi-lâminas pneumáticas ou corte óptico a laser CO2 sem clichês físicos.",
    badge: "LÂMINA / LASER CO2"
  },
  {
    id: "laminado",
    title: "Laminação a Frio Integrada",
    subtitle: "PROTEÇÃO CONTRA ABRASÃO E ÁGUA",
    icon: "layers",
    description: "Aplicação contínua de laminação a frio com controle de tensão de freio para vedação contra umidade, solventes e atrito mecânico.",
    badge: "LAMINAÇÃO A FRIO"
  },
  {
    id: "barnizado",
    title: "Envernizamento & Secagem",
    subtitle: "CURA INSTANTÂNEA NIR / UV LED",
    icon: "format_paint",
    description: "Secagem instantânea por lâmpadas de infravermelho próximo (NIR) ou cura UV LED fria para fixação total de verniz protetor e brilho.",
    badge: "CURA NIR / UV"
  },
  {
    id: "embobinado",
    title: "Rebobinamento & Inspeção",
    subtitle: "CONTROLE DE QUALIDADE QA 100%",
    icon: "sync_alt",
    description: "Módulos de rebobinamento com controle de alinhamento por sensor ultrassônico e contagem fotoelétrica para liberação de lotes sem falhas.",
    badge: "INSPEÇÃO & QA"
  }
];
---

<section id="capabilities" class="py-16 sm:py-24 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto border-t border-slate-200">
  <div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-6 mb-12">
    <div class="space-y-3">
      <span class="font-['Space_Grotesk',monospace] text-xs font-semibold px-3.5 py-1.5 bg-slate-900 text-white inline-block rounded-none uppercase">
        CAPACIDADES DE PROCESSO
      </span>
      <h2 class="font-['Plus_Jakarta_Sans',sans-serif] text-3xl sm:text-5xl font-extrabold text-slate-900 tracking-tight">
        Impressão & Acabamento Integrado
      </h2>
    </div>
    <p class="max-w-md text-slate-600 text-sm leading-relaxed font-['Space_Grotesk',monospace]">
      Distribuição e suporte de equipamentos digitais de alta precisão para rótulos e embalagens em fluxo contínuo.
    </p>
  </div>

  <!-- 6 Process Cards Grid (Sharp Square 0px Radius) -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
    {CAPABILITIES.map(item => (
      <div class="bg-white p-6 sm:p-8 border border-slate-200 shadow-xs hover:shadow-xl transition-all duration-300 flex flex-col justify-between group rounded-none cursor-crosshair space-y-6">
        <div class="space-y-4">
          <div class="flex justify-between items-start">
            <div class="w-12 h-12 bg-slate-100 border border-slate-200 flex items-center justify-center rounded-none group-hover:bg-slate-900 group-hover:text-white transition-colors">
              <span class="material-symbols-outlined text-2xl">{item.icon}</span>
            </div>
            <span class="font-['Space_Grotesk',monospace] text-[10px] font-bold px-2.5 py-1 bg-slate-50 border border-slate-200 text-slate-700 rounded-none">
              {item.badge}
            </span>
          </div>

          <div class="space-y-1">
            <span class="font-['Space_Grotesk',monospace] text-[11px] font-bold text-[#00aeef] uppercase block">
              {item.subtitle}
            </span>
            <h3 class="font-['Plus_Jakarta_Sans',sans-serif] text-xl font-bold text-slate-900 group-hover:text-[#00aeef] transition-colors">
              {item.title}
            </h3>
          </div>

          <p class="text-xs text-slate-600 leading-relaxed font-['Space_Grotesk',monospace]">
            {item.description}
          </p>
        </div>

        <div class="pt-4 border-t border-slate-100 flex items-center justify-between font-['Space_Grotesk',monospace] text-xs font-semibold text-slate-500">
          <span>EQUIPAMENTOS HOMOLOGADOS</span>
          <span class="text-slate-900 group-hover:text-[#00aeef]">TECNOLOGIA 2026 ↗</span>
        </div>
      </div>
    ))}
  </div>
</section>
