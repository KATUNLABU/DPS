---
---

<section id="calculator" class="py-16 sm:py-24 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto border-t border-slate-200">
  <div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-6 mb-12">
    <div class="space-y-3">
      <span class="font-['Space_Grotesk',monospace] text-xs font-semibold px-3.5 py-1.5 bg-[#00aeef]/10 text-[#00aeef] inline-block rounded-none">
        SIMULADOR DE EFICIENCIA
      </span>
      <h2 class="font-['Plus_Jakarta_Sans',sans-serif] text-3xl sm:text-5xl font-extrabold text-slate-900 tracking-tight">
        Calculadora de Retorno de Inversión (ROI)
      </h2>
    </div>
    <p class="max-w-md text-slate-600 text-sm leading-relaxed font-['Space_Grotesk',monospace]">
      Compara el tiempo de preparación, costo en placas y tiempo total de producción entre la impresión digital Katun DPS y la flexografía tradicional.
    </p>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    <!-- Controls Container (Square) -->
    <div class="lg:col-span-5 bg-white p-6 sm:p-8 border border-slate-200 shadow-sm space-y-6 rounded-none">
      <div>
        <label class="font-['Space_Grotesk',monospace] text-xs font-semibold text-slate-800 block mb-2">
          CANTIDAD DE ETIQUETAS POR TIRAJE: <span id="run-qty-val" class="text-[#00aeef] font-bold text-sm">5,000</span>
        </label>
        <input 
          type="range" 
          id="run-qty-range" 
          min="500" 
          max="50000" 
          step="500" 
          value="5000" 
          class="w-full accent-[#00aeef] cursor-crosshair"
        />
        <div class="flex justify-between font-['Space_Grotesk',monospace] text-[10px] text-slate-400 mt-1">
          <span>500 UNID</span>
          <span>25,000 UNID</span>
          <span>50,000 UNID</span>
        </div>
      </div>

      <div>
        <label class="font-['Space_Grotesk',monospace] text-xs font-semibold text-slate-800 block mb-2">
          NÚMERO DE DISEÑOS / VARIANTES: <span id="designs-val" class="text-[#e11d48] font-bold text-sm">4</span>
        </label>
        <input 
          type="range" 
          id="designs-range" 
          min="1" 
          max="12" 
          step="1" 
          value="4" 
          class="w-full accent-[#e11d48] cursor-crosshair"
        />
      </div>

      <div class="p-4 bg-slate-50 border border-slate-200/80 space-y-2 rounded-none">
        <span class="font-['Space_Grotesk',monospace] text-xs font-bold text-slate-900 block">
          Beneficios Clave Katun DPS:
        </span>
        <ul class="font-['Space_Grotesk',monospace] text-xs text-slate-600 space-y-1.5">
          <li class="flex items-center gap-2"><span class="text-[#00aeef] font-bold">✓</span> Sin costos de fotolitos ni placas</li>
          <li class="flex items-center gap-2"><span class="text-[#00aeef] font-bold">✓</span> Preparación de 2 minutos por archivo</li>
          <li class="flex items-center gap-2"><span class="text-[#00aeef] font-bold">✓</span> Desperdicio de sustrato &lt; 2 metros</li>
        </ul>
      </div>
    </div>

    <!-- Comparison Results Grid (Square) -->
    <div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-6">
      <!-- Katun DPS Digital Box -->
      <div class="bg-white border-2 border-[#00aeef] p-6 sm:p-8 shadow-sm flex flex-col justify-between space-y-6 rounded-none">
        <div>
          <span class="font-['Space_Grotesk',monospace] text-xs font-bold bg-[#00aeef] text-white px-3 py-1 inline-block mb-4 rounded-none">
            IMPRESIÓN DIGITAL KATUN DPS
          </span>
          
          <div class="space-y-4 font-['Space_Grotesk',monospace]">
            <div>
              <span class="text-xs text-slate-400 block font-medium">TIEMPO PREPARACIÓN (SETUP)</span>
              <span class="font-['Plus_Jakarta_Sans',sans-serif] text-3xl font-extrabold text-[#00aeef]" id="dps-prep-time">8 MIN</span>
            </div>
            <div>
              <span class="text-xs text-slate-400 block font-medium">COSTO EN PLACAS/MATRICES</span>
              <span class="font-['Plus_Jakarta_Sans',sans-serif] text-3xl font-extrabold text-[#00aeef]">$0.00 MXN</span>
            </div>
            <div>
              <span class="text-xs text-slate-400 block font-medium">TIEMPO TOTAL ESTIMADO</span>
              <span class="font-['Plus_Jakarta_Sans',sans-serif] text-3xl font-extrabold text-slate-900" id="dps-total-time">32 MIN</span>
            </div>
          </div>
        </div>

        <div class="pt-4 border-t border-slate-100">
          <span class="font-['Space_Grotesk',monospace] text-xs font-semibold text-emerald-600 flex items-center gap-1.5">
            <span class="w-2 h-2 bg-emerald-500"></span> Listo para entrega el mismo día
          </span>
        </div>
      </div>

      <!-- Traditional Flexo Box -->
      <div class="bg-white border border-slate-200 p-6 sm:p-8 shadow-sm flex flex-col justify-between space-y-6 rounded-none">
        <div>
          <span class="font-['Space_Grotesk',monospace] text-xs font-bold bg-slate-100 text-slate-700 px-3 py-1 inline-block mb-4 border border-slate-200 rounded-none">
            FLEXOGRAFÍA TRADICIONAL
          </span>

          <div class="space-y-4 font-['Space_Grotesk',monospace]">
            <div>
              <span class="text-xs text-slate-400 block font-medium">TIEMPO PREPARACIÓN (SETUP)</span>
              <span class="font-['Plus_Jakarta_Sans',sans-serif] text-3xl font-extrabold text-rose-500" id="flexo-prep-time">240 MIN</span>
            </div>
            <div>
              <span class="text-xs text-slate-400 block font-medium">COSTO ESTIMADO PLACAS</span>
              <span class="font-['Plus_Jakarta_Sans',sans-serif] text-3xl font-extrabold text-rose-500" id="flexo-plates-cost">$12,800 MXN</span>
            </div>
            <div>
              <span class="text-xs text-slate-400 block font-medium">TIEMPO TOTAL ESTIMADO</span>
              <span class="font-['Plus_Jakarta_Sans',sans-serif] text-3xl font-extrabold text-slate-900" id="flexo-total-time">48 HRS</span>
            </div>
          </div>
        </div>

        <div class="pt-4 border-t border-slate-100">
          <span class="font-['Space_Grotesk',monospace] text-xs font-semibold text-rose-500 flex items-center gap-1.5">
            <span class="w-2 h-2 bg-rose-500"></span> Requiere 2-3 días en pre-prensa
          </span>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const qtyRange = document.getElementById('run-qty-range');
    const qtyVal = document.getElementById('run-qty-val');
    const designsRange = document.getElementById('designs-range');
    const designsVal = document.getElementById('designs-val');

    const dpsPrepTime = document.getElementById('dps-prep-time');
    const dpsTotalTime = document.getElementById('dps-total-time');

    const flexoPrepTime = document.getElementById('flexo-prep-time');
    const flexoPlatesCost = document.getElementById('flexo-plates-cost');
    const flexoTotalTime = document.getElementById('flexo-total-time');

    function calculateROI() {
      const qty = parseInt(qtyRange.value, 10);
      const designs = parseInt(designsRange.value, 10);

      qtyVal.textContent = qty.toLocaleString('es-MX');
      designsVal.textContent = designs.toString();

      // DPS Calculation: 2 min prep per design, 18m/min speed
      const dpsPrepMinutes = designs * 2;
      const dpsPrintMinutes = Math.ceil(qty / 200);
      const dpsTotal = dpsPrepMinutes + dpsPrintMinutes;

      dpsPrepTime.textContent = `${dpsPrepMinutes} MIN`;
      dpsTotalTime.textContent = `${dpsTotal} MIN`;

      // Flexo Calculation: 60 min prep per design, $3,200 per plate set
      const flexoPrepMinutes = designs * 60;
      const flexoCost = designs * 3200;
      const flexoHours = Math.ceil((flexoPrepMinutes + Math.ceil(qty / 300)) / 60) + 24;

      flexoPrepTime.textContent = `${flexoPrepMinutes} MIN`;
      flexoPlatesCost.textContent = `$${flexoCost.toLocaleString('es-MX')} MXN`;
      flexoTotalTime.textContent = `${flexoHours} HRS`;
    }

    if (qtyRange && designsRange) {
      qtyRange.addEventListener('input', calculateROI);
      designsRange.addEventListener('input', calculateROI);
      calculateROI();
    }
  });
</script>
