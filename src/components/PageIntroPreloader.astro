<style>
  /* Lino Toner Stamp Cards */
  .lino-stamp-card {
    width: clamp(160px, 17vw, 200px);
    height: clamp(120px, 13vw, 150px);
    background: #ffffff;
    border: 3.5px solid #0a2be5;
    border-radius: 0px;
    padding: 12px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    box-shadow: 6px 6px 0px #0a2be5;
    flex-shrink: 0;
    position: relative;
  }

  .lino-stamp-card::before {
    content: '';
    position: absolute;
    inset: 4px;
    border: 1px dashed rgba(10, 43, 229, 0.4);
    pointer-events: none;
  }

  /* Central Lino Badge */
  .central-lino-badge {
    width: clamp(230px, 29vw, 330px);
    height: clamp(230px, 29vw, 330px);
    box-shadow: 10px 10px 0px #0a2be5;
  }

  /* Lino Tap Badge */
  .lino-tap-badge {
    position: absolute;
    bottom: -20px;
    left: 50%;
    transform: translateX(-50%);
    background: #ffffff;
    border: 3px solid #0a2be5;
    border-radius: 0px;
    padding: 6px 18px;
    display: flex;
    align-items: center;
    gap: 8px;
    box-shadow: 4px 4px 0px #0a2be5;
    white-space: nowrap;
    z-index: 30;
    transition: all 0.2s ease;
  }

  .lino-tap-badge:hover {
    transform: translateX(-50%) translate(-2px, -2px);
    box-shadow: 6px 6px 0px #0a2be5;
  }

  .animate-tap-bounce {
    animation: tapBounce 1.2s infinite ease-in-out;
  }

  @keyframes tapBounce {
    0%, 100% { transform: translateY(0) scale(1); }
    50% { transform: translateY(3px) scale(0.85); }
  }

  /* Transparent Window Reveal */
  .peeled-transparent-window {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: transparent;
    pointer-events: none;
    opacity: 0;
    z-index: 4;
    transition: opacity 0.3s ease;
  }

  .peeled-transparent-window.active {
    opacity: 1;
  }

  .window-border-ring {
    position: absolute;
    inset: -8px;
    border-radius: 50%;
    border: 4px solid #0a2be5;
    box-shadow: 0 0 20px rgba(10, 43, 229, 0.4);
    filter: blur(2px);
  }
</style>

<script>
  import gsap from 'gsap';

  const initPreloader = () => {
    const preloader = document.getElementById('intro-preloader');
    const tapeStrip = document.getElementById('tapeStrip');
    const centralSticker = document.getElementById('centralSticker');
    const transparentWindow = document.getElementById('transparentWindow');
    const clickPrompt = document.getElementById('clickPrompt');
    const progressBar = document.getElementById('progressBar');

    if (!preloader || !tapeStrip) return;

    // Ruta de verificación: ÚNICAMENTE en la página principal '/' o '/index.html'
    const currentPath = window.location.pathname.replace(/\/$/, '') || '/';
    if (currentPath !== '/' && currentPath !== '/index.html') {
      preloader.style.display = 'none';
      preloader.style.pointerEvents = 'none';
      return;
    }

    let isPeeling = false;
    let autoRevealTimer: any = null;
    let currentTimeline: gsap.core.Timeline | null = null;

    // Ajustar transform origins para los elementos SVG
    const svgElements = document.querySelectorAll('#punto_d, #punto_p, #punto_s, #katun, #d, #p, #s, #tm, #logo-katun');
    svgElements.forEach((el) => {
      gsap.set(el, {
        transformBox: 'fill-box',
        transformOrigin: 'center center'
      });
    });

    // Calcula la coordenada X exacta para que el sticker KATUN (índice 3) quede en el centro exacto
    function calculateCenteredX(elementIndex: number) {
      const items = tapeStrip.children;
      if (!items || items.length <= elementIndex) return 0;
      const targetItem = items[elementIndex] as HTMLElement;
      
      const viewportCenter = window.innerWidth / 2;
      const itemCenter = targetItem.offsetLeft + (targetItem.offsetWidth / 2);
      
      return viewportCenter - itemCenter;
    }

    // Transición de revelado suave
    function triggerStickerPeelAndZoom() {
      if (isPeeling) return;
      isPeeling = true;

      if (autoRevealTimer) clearTimeout(autoRevealTimer);

      if (clickPrompt) {
        clickPrompt.style.opacity = '0';
      }

      if (transparentWindow) {
        transparentWindow.classList.add('active');
      }

      const initialRadius = Math.min(window.innerWidth * 0.12, 130);
      const maxRadius = Math.max(window.innerWidth, window.innerHeight) * 1.6;

      if (centralSticker) {
        gsap.to(centralSticker, {
          opacity: 0,
          scale: 1.1,
          duration: 0.25,
          ease: 'power2.out'
        });
      }

      const zoomState = { radius: initialRadius, scale: 1, opacity: 1 };

      gsap.to(zoomState, {
        radius: maxRadius,
        scale: 1.25,
        opacity: 0,
        duration: 1.0,
        ease: 'power3.inOut',
        onUpdate: function () {
          const r = zoomState.radius;
          const s = zoomState.scale;
          const o = zoomState.opacity;

          const innerFeather = Math.max(0, r - 30);
          const outerFeather = r + 35;

          const maskString = `radial-gradient(circle at 50% 50%, transparent 0px, transparent ${innerFeather}px, rgba(0, 0, 0, 0.8) ${r}px, black ${outerFeather}px)`;

          gsap.set(preloader, {
            maskImage: maskString,
            webkitMaskImage: maskString,
            scale: s,
            opacity: o
          });
        },
        onComplete: () => {
          gsap.set(preloader, { display: 'none', pointerEvents: 'none' });
        }
      });
    }

    // Duración total ~7.0s
    function startIntroTimeline(startProgress = 0) {
      if (currentTimeline) {
        currentTimeline.kill();
      }

      const startX = calculateCenteredX(0);
      const targetX = calculateCenteredX(3);

      const tl = gsap.timeline({
        onUpdate: () => {
          if (progressBar) {
            const p = (tl.progress() * 100).toFixed(1);
            progressBar.style.width = `${p}%`;
          }
        },
        onComplete: () => {
          if (progressBar) progressBar.style.width = '100%';
          autoRevealTimer = setTimeout(() => {
            triggerStickerPeelAndZoom();
          }, 800);
        }
      });

      // 1. Desplazamiento desde startX a targetX (Duración 5.8s)
      tl.fromTo(
        tapeStrip,
        { x: startX },
        {
          x: targetX,
          duration: 5.8,
          ease: 'power2.inOut'
        },
        0
      )
      // 2. Micro-rebote de precisión en el sticker central Katun DPS
      .to(
        centralSticker,
        {
          scale: 1.06,
          duration: 0.25,
          yoyo: true,
          repeat: 1,
          ease: 'sine.inOut'
        },
        5.8
      );

      currentTimeline = tl;

      if (startProgress > 0) {
        tl.progress(startProgress);
      }
    }

    // Eventos de clic
    if (centralSticker) {
      centralSticker.addEventListener('click', (e) => {
        e.stopPropagation();
        triggerStickerPeelAndZoom();
      });
    }

    if (clickPrompt) {
      clickPrompt.addEventListener('click', (e) => {
        e.stopPropagation();
        triggerStickerPeelAndZoom();
      });
    }

    preloader.addEventListener('click', () => {
      triggerStickerPeelAndZoom();
    });

    // Iniciar la animación al cargar
    startIntroTimeline();

    window.addEventListener('resize', () => {
      if (currentTimeline && !isPeeling) {
        const prog = currentTimeline.progress();
        startIntroTimeline(prog);
      }
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPreloader);
  } else {
    initPreloader();
  }
</script>
