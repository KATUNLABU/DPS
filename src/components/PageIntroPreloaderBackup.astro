<style>
  :root {
    --accent-cyan: #009ee2;
    --accent-magenta: #e5007e;
    --accent-yellow: #fcc200;
  }

  /* Escenario de Pista de Impresión */
  .press-stage-fullscreen {
    width: 100vw;
    height: clamp(320px, 52vh, 480px);
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  /* TIRA DE PAPEL CONTINUO */
  .press-stage-fullscreen::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    height: clamp(280px, 46vh, 430px);
    transform: translateY(-50%);
    background: 
      radial-gradient(circle at 50% 50%, rgba(255,255,255,0.85) 0%, rgba(244,240,230,0.65) 100%),
      linear-gradient(180deg, #fefefe 0%, #f7f3eb 50%, #eee8dc 100%);
    border-top: 1.5px solid rgba(0,0,0,0.08);
    border-bottom: 1.5px solid rgba(0,0,0,0.08);
    z-index: 3;
    box-shadow: 
      inset 0 4px 14px rgba(0,0,0,0.05),
      inset 0 -4px 14px rgba(0,0,0,0.05),
      0 22px 50px rgba(0, 0, 0, 0.16),
      0 8px 22px rgba(0, 0, 0, 0.09);
  }

  /* Continuous Paper Tape Strip */
  .tape-strip {
    position: absolute;
    top: 50%;
    left: 0;
    transform: translateY(-50%);
    display: flex;
    align-items: center;
    gap: clamp(24px, 4.4vw, 56px);
    width: max-content;
    will-change: transform, filter;
    backface-visibility: hidden;
    z-index: 5;
    transform-style: preserve-3d;
  }

  /* UNIFORM CIRCULAR STICKERS */
  .label-unit {
    width: clamp(150px, 20vw, 220px);
    height: clamp(150px, 20vw, 220px);
    flex-shrink: 0;
    padding: clamp(10px, 1.5vw, 18px);
    background: #ffffff;
    border: 2.5px solid rgba(0, 0, 0, 0.12);
    border-radius: 50%;
    margin: 0 !important;
    position: relative;
    box-shadow: 
      0 8px 24px rgba(0,0,0,0.12),
      inset 0 0 10px rgba(0,0,0,0.03);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
  }

  .label-unit::after {
    content: '';
    position: absolute;
    inset: -6px;
    border-radius: 50%;
    border: 1.5px solid rgba(0, 158, 226, 0.35);
    pointer-events: none;
  }

  /* WRAPPER Y VENTANA TRANSPARENTE EN LA TIRA DE PAPEL */
  .label-unit-wrapper {
    position: relative;
    width: clamp(150px, 20vw, 220px);
    height: clamp(150px, 20vw, 220px);
    flex-shrink: 0;
    margin: 0 !important;
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
  }

  .label-unit-wrapper .label-unit {
    margin: 0 !important;
  }

  /* Ventana Transparente con Anillo de Borde Suavemente Difuminado */
  .peeled-transparent-window {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: transparent;
    pointer-events: none;
    opacity: 0;
    z-index: 4;
    transition: opacity 0.3s ease;
  }

  .peeled-transparent-window.active {
    opacity: 1;
  }

  /* Stroke / Contorno difuminado */
  .window-border-ring {
    position: absolute;
    inset: -8px;
    border-radius: 50%;
    border: 4px solid rgba(0, 158, 226, 0.6);
    box-shadow: 
      0 0 25px rgba(0, 158, 226, 0.5),
      inset 0 0 20px rgba(0, 0, 0, 0.35);
    filter: blur(3px);
  }

  /* ESTAMPA PRINCIPAL INTERACTIVA CON CURSOR POINTER Y SHADOW HOVER */
  .label-active {
    cursor: pointer;
    transform-style: preserve-3d;
    transition: transform 0.25s ease, box-shadow 0.25s ease, opacity 0.25s ease;
    z-index: 10;
  }

  .label-active:hover {
    transform: scale(1.05);
    box-shadow: 0 15px 40px rgba(0, 158, 226, 0.35);
  }

  /* NUEVA INSIGNIA MINIMALISTA JUSTO EN MEDIO DE LA ESTAMPA CENTRAL */
  .minimal-enter-badge {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) scale(0.9);
    background: rgba(15, 23, 42, 0.88);
    backdrop-filter: blur(8px);
    color: #ffffff;
    font-size: clamp(0.7rem, 0.85vw, 0.78rem);
    font-weight: 700;
    letter-spacing: 0.6px;
    padding: 6px 14px;
    border-radius: 20px;
    border: 1px solid rgba(0, 158, 226, 0.6);
    box-shadow: 0 4px 16px rgba(0, 158, 226, 0.4);
    white-space: nowrap;
    opacity: 0;
    transition: all 0.35s ease;
    z-index: 30;
    pointer-events: none;
  }

  .minimal-enter-badge.visible {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
    animation: minimalPulse 1.8s infinite ease-in-out;
  }

  @keyframes minimalPulse {
    0%, 100% {
      transform: translate(-50%, -50%) scale(1);
      box-shadow: 0 4px 16px rgba(0, 158, 226, 0.4);
    }
    50% {
      transform: translate(-50%, -50%) scale(1.06);
      box-shadow: 0 6px 22px rgba(0, 158, 226, 0.75);
    }
  }

  /* MARCAS PROFESIONALES DE IMPRESIÓN Y REGISTRO CMYK */
  .print-marks-unit {
    background: #ffffff;
    border: 2px solid #94a3b8;
    position: relative;
    overflow: hidden;
  }

  .registration-cross {
    position: absolute;
    width: clamp(16px, 2vw, 22px);
    height: clamp(16px, 2vw, 22px);
    border: 1.5px solid #0f172a;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .registration-cross::before {
    content: '';
    position: absolute;
    width: 26px;
    height: 1.5px;
    background: #0f172a;
  }

  .registration-cross::after {
    content: '';
    position: absolute;
    width: 1.5px;
    height: 26px;
    background: #0f172a;
  }

  .registration-cross.top-left { top: 10px; left: 10px; }
  .registration-cross.top-right { top: 10px; right: 10px; }
  .registration-cross.bottom-left { bottom: 10px; left: 10px; }
  .registration-cross.bottom-right { bottom: 10px; right: 10px; }

  /* CMYK Color Strip */
  .cmyk-color-strip {
    display: flex;
    gap: 5px;
    margin-bottom: 6px;
    z-index: 2;
  }

  .cmyk-color-strip .patch {
    width: clamp(14px, 1.8vw, 20px);
    height: clamp(14px, 1.8vw, 20px);
    border-radius: 4px;
    border: 1px solid rgba(0,0,0,0.25);
  }

  .patch.cyan { background: var(--accent-cyan); }
  .patch.magenta { background: var(--accent-magenta); }
  .patch.yellow { background: var(--accent-yellow); }
  .patch.key { background: #0f172a; }

  .press-target-title {
    font-family: monospace;
    font-size: clamp(0.5rem, 0.75vw, 0.65rem);
    font-weight: 800;
    color: #1e293b;
    letter-spacing: 0.5px;
    text-align: center;
    margin: 4px 0;
    z-index: 2;
  }

  .grayscale-strip {
    width: clamp(80px, 12vw, 120px);
    height: 8px;
    border-radius: 3px;
    background: linear-gradient(90deg, #000000, #475569, #94a3b8, #cbd5e1, #ffffff);
    border: 1px solid rgba(0,0,0,0.25);
    z-index: 2;
  }

  svg.svg-label {
    width: 100%;
    height: auto;
    overflow: visible;
  }
</style>

<script>
  import gsap from 'gsap';

  const initPreloader = () => {
    const preloader = document.getElementById('intro-preloader');
    const tapeStrip = document.getElementById('tapeStrip');
    const logoKatun = document.getElementById('logo-katun');
    const centralSticker = document.getElementById('centralSticker');
    const transparentWindow = document.getElementById('transparentWindow');
    const clickPrompt = document.getElementById('clickPrompt');

    if (!preloader || !tapeStrip) return;

    // Ruta de verificación: ÚNICAMENTE en la página principal '/' o '/index.html'
    const currentPath = window.location.pathname.replace(/\/$/, '') || '/';
    if (currentPath !== '/' && currentPath !== '/index.html') {
      preloader.style.display = 'none';
      preloader.style.pointerEvents = 'none';
      return;
    }

    let isPeeling = false;
    let autoRevealTimer: any = null;
    let currentTimeline: gsap.core.Timeline | null = null;

    // Ajustar transform origins para los elementos SVG
    const svgElements = document.querySelectorAll('#punto_d, #punto_p, #punto_s, #katun, #d, #p, #s, #tm, #logo-katun');
    svgElements.forEach((el) => {
      gsap.set(el, {
        transformBox: 'fill-box',
        transformOrigin: 'center center'
      });
    });

    // Calcula la coordenada X exacta para que el elemento objetivo quede 100% DEAD CENTER en el viewport
    function calculateCenteredX(elementIndex: number) {
      const items = tapeStrip.children;
      if (!items || items.length <= elementIndex) return 0;
      const targetItem = items[elementIndex] as HTMLElement;
      
      const viewportCenter = window.innerWidth / 2;
      const itemCenter = targetItem.offsetLeft + (targetItem.offsetWidth / 2);
      
      // X = viewportCenter - itemCenter pone el centro del elemento en la mitad exacta de la pantalla
      return viewportCenter - itemCenter;
    }

    // Transición de revelado con máscara radial zoom
    function triggerStickerPeelAndZoom() {
      if (isPeeling) return;
      isPeeling = true;

      if (autoRevealTimer) clearTimeout(autoRevealTimer);

      if (clickPrompt) {
        clickPrompt.classList.remove('visible');
      }

      if (transparentWindow) {
        transparentWindow.classList.add('active');
      }

      const initialRadius = Math.min(window.innerWidth * 0.10, 110);
      const maxRadius = Math.max(window.innerWidth, window.innerHeight) * 1.6;

      // Desvanecimiento rápido de la estampa central
      if (centralSticker) {
        gsap.to(centralSticker, {
          opacity: 0,
          scale: 1.08,
          duration: 0.25,
          ease: 'power2.out'
        });
      }

      // Expansión suave de la máscara radial
      const zoomState = { radius: initialRadius, scale: 1, opacity: 1 };

      gsap.to(zoomState, {
        radius: maxRadius,
        scale: 1.25,
        opacity: 0,
        duration: 1.1,
        ease: 'power3.inOut',
        onUpdate: function () {
          const r = zoomState.radius;
          const s = zoomState.scale;
          const o = zoomState.opacity;

          const innerFeather = Math.max(0, r - 28);
          const outerFeather = r + 32;

          const maskString = `radial-gradient(circle at 50% 50%, transparent 0px, transparent ${innerFeather}px, rgba(0, 0, 0, 0.75) ${r}px, black ${outerFeather}px)`;

          gsap.set(preloader, {
            maskImage: maskString,
            webkitMaskImage: maskString,
            scale: s,
            opacity: o
          });
        },
        onComplete: () => {
          gsap.set(preloader, { display: 'none', pointerEvents: 'none' });
        }
      });
    }

    // Crear la línea de tiempo con centrado 100% exacto para el 4to sticker (índice 3)
    function startIntroTimeline(startProgress = 0) {
      if (currentTimeline) {
        currentTimeline.kill();
      }

      // Posición X para centrar el 1er sticker (índice 0) al inicio
      const startX = calculateCenteredX(0);
      // Posición X para centrar el 4to sticker (índice 3, KATUN DPS) al final
      const targetX = calculateCenteredX(3);
      const blurState = { blur: 22 };

      const tl = gsap.timeline({
        onComplete: () => {
          if (clickPrompt) {
            clickPrompt.classList.add('visible');
          }
          // Transición automática exacta a los 3 segundos de entrar a la página
          autoRevealTimer = setTimeout(() => {
            triggerStickerPeelAndZoom();
          }, 400);
        }
      });

      // 1. Desplazamiento desde startX a targetX (Duración de 2.6s para completar en ~3s total)
      tl.fromTo(
        tapeStrip,
        { x: startX },
        {
          x: targetX,
          duration: 2.6,
          ease: 'power3.out'
        },
        0
      )
      // 2. Disminución paulatina del blur de movimiento (22px -> 0px)
      .to(
        blurState,
        {
          blur: 0,
          duration: 2.6,
          ease: 'power3.out',
          onUpdate: () => {
            gsap.set(tapeStrip, { filter: `blur(${blurState.blur.toFixed(1)}px)` });
          }
        },
        0
      )
      // 3. Micro-rebote de precisión en el centro exacto de la pantalla
      .to(
        logoKatun,
        {
          scale: 1.06,
          duration: 0.15,
          yoyo: true,
          repeat: 1,
          ease: 'sine.inOut'
        },
        2.6
      );

      currentTimeline = tl;

      if (startProgress > 0) {
        tl.progress(startProgress);
      }
    }

    // Eventos de clic para entrar inmediatamente en cualquier momento
    if (centralSticker) {
      centralSticker.addEventListener('click', (e) => {
        e.stopPropagation();
        triggerStickerPeelAndZoom();
      });
    }

    if (clickPrompt) {
      clickPrompt.addEventListener('click', (e) => {
        e.stopPropagation();
        triggerStickerPeelAndZoom();
      });
    }

    preloader.addEventListener('click', () => {
      triggerStickerPeelAndZoom();
    });

    // Iniciar la animación al cargar
    startIntroTimeline();

    // Recalcular centrado exacto si se cambia el tamaño de la ventana
    window.addEventListener('resize', () => {
      if (currentTimeline && !isPeeling) {
        const prog = currentTimeline.progress();
        startIntroTimeline(prog);
      }
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPreloader);
  } else {
    initPreloader();
  }
</script>
