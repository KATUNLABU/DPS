---
import DpsLogo from './DpsLogo.astro';
---

<header
  class="fixed top-0 z-50 w-full h-16 bg-white/95 backdrop-blur-md border-b border-slate-200 shadow-xs flex items-center"
>
  <div
    class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full flex justify-between items-center"
  >
    <!-- Brand Logo Oficial DPS -->
    <div class="flex items-center gap-3">
      <button
        class="md:hidden text-slate-700 hover:text-slate-900 transition-colors p-1 cursor-crosshair"
        onclick="toggleDrawer()"
        aria-label="Abrir Menu"
      >
        <span class="material-symbols-outlined text-2xl">menu</span>
      </button>

      <a href="/" class="flex items-center group cursor-crosshair py-1" aria-label="Katun DPS Início">
        <DpsLogo class="h-9 sm:h-10 w-auto" theme="light" />
      </a>
    </div>

    <!-- Desktop Navigation -->
    <nav
      class="hidden md:flex items-center gap-7 font-['Plus_Jakarta_Sans',sans-serif] text-xs font-semibold"
    >
      <!-- INÍCIO Button with Dropdown Menu for Sections -->
      <div class="relative group py-4">
        <a
          id="nav-inicio"
          href="/"
          class="nav-link flex items-center gap-1 text-slate-600 hover:text-[#00aeef] transition-all cursor-crosshair py-1.5 uppercase"
        >
          <span>INÍCIO</span>
          <span
            class="material-symbols-outlined text-sm transition-transform group-hover:rotate-180"
            >expand_more</span
          >
        </a>

        <!-- Dropdown Menu for homepage sections -->
        <div
          class="absolute top-full left-0 w-64 bg-white border border-slate-200 shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 py-2 rounded-none"
        >
          <div
            class="px-4 py-2 bg-slate-50 border-b border-slate-100 font-['Space_Grotesk',monospace] text-[10px] text-slate-400 font-bold uppercase tracking-wider"
          >
            SEÇÕES PRINCIPAIS
          </div>

          <a
            href="/"
            class="flex items-center gap-2.5 px-4 py-2.5 text-xs text-slate-700 hover:bg-[#00aeef]/10 hover:text-[#00aeef] transition-colors cursor-crosshair font-semibold"
          >
            <span class="material-symbols-outlined text-sm text-slate-400">home</span>
            <span>Página Inicial</span>
          </a>
          <a
            href="/#specs"
            class="flex items-center gap-2.5 px-4 py-2.5 text-xs text-slate-700 hover:bg-[#00aeef]/10 hover:text-[#00aeef] transition-colors cursor-crosshair"
          >
            <span class="material-symbols-outlined text-sm text-slate-400">memory</span>
            <span>Tecnologia Memjet & Laser</span>
          </a>
          <a
            href="/#industries"
            class="flex items-center gap-2.5 px-4 py-2.5 text-xs text-slate-700 hover:bg-[#00aeef]/10 hover:text-[#00aeef] transition-colors cursor-crosshair"
          >
            <span class="material-symbols-outlined text-sm text-slate-400">factory</span>
            <span>Setores Industriais</span>
          </a>
          <a
            href="/#process"
            class="flex items-center gap-2.5 px-4 py-2.5 text-xs text-slate-700 hover:bg-[#00aeef]/10 hover:text-[#00aeef] transition-colors cursor-crosshair"
          >
            <span class="material-symbols-outlined text-sm text-slate-400">precision_manufacturing</span>
            <span>Processo de Trabalho</span>
          </a>
          <a
            href="/#calculator"
            class="flex items-center gap-2.5 px-4 py-2.5 text-xs text-slate-700 hover:bg-[#00aeef]/10 hover:text-[#00aeef] transition-colors cursor-crosshair"
          >
            <span class="material-symbols-outlined text-sm text-slate-400">calculate</span>
            <span>Simulador de ROI</span>
          </a>
        </div>
      </div>

      <!-- CATÁLOGO COMPLETO Link -->
      <a
        id="nav-catalogo"
        href="/catalogo"
        class="nav-link text-slate-600 hover:text-[#00aeef] transition-all cursor-crosshair py-1.5 uppercase"
      >
        CATÁLOGO COMPLETO
      </a>

      <!-- INDÚSTRIAS Link -->
      <a
        id="nav-industrias"
        href="/industrias"
        class="nav-link text-slate-600 hover:text-[#00aeef] transition-all cursor-crosshair py-1.5 uppercase"
      >
        INDÚSTRIAS
      </a>

      <!-- BLOG Link -->
      <a
        id="nav-blog"
        href="/blog"
        class="nav-link text-slate-600 hover:text-[#00aeef] transition-all cursor-crosshair py-1.5 font-bold uppercase"
      >
        BLOG
      </a>

      <!-- CONTATO Link -->
      <a
        id="nav-contacto"
        href="/contacto"
        class="nav-link text-slate-600 hover:text-[#00aeef] transition-all cursor-crosshair py-1.5 uppercase"
      >
        FALE COM UM ESPECIALISTA
      </a>
    </nav>

    <!-- Header Actions (Region Flag + Cassio WhatsApp) -->
    <div class="flex items-center gap-3">
      <!-- Region Selector Badge -->
      <div class="hidden sm:flex items-center gap-1.5 px-2.5 py-1 bg-slate-100 border border-slate-200 text-[11px] font-['Space_Grotesk',monospace] font-semibold text-slate-700" title="Katun DPS Brasil & América Latina">
        <span>🇧🇷</span>
        <span>BR / PT</span>
      </div>

      <!-- WhatsApp Button -> Direct to Cássio Rodrigues (Corporate) -->
      <a
        href="https://wa.me/5511945222069?text=Ol%C3%A1%20C%C3%A1ssio%2C%20gostaria%20de%20informa%C3%A7%C3%B5es%20e%20cota%C3%A7%C3%A3o%20sobre%20os%20equipamentos%20Katun%20DPS"
        target="_blank"
        rel="noopener"
        class="bg-slate-900 text-white hover:bg-[#00aeef] transition-all text-xs font-semibold px-4 py-2 flex items-center gap-1.5 shadow-sm rounded-none cursor-crosshair uppercase"
        title="Fale direto com Eng. Cássio Rodrigues no WhatsApp Corporativo (+55 11 94522-2069)"
      >
        <span class="material-symbols-outlined text-sm">chat</span>
        <span class="hidden sm:inline">WHATSAPP</span>
      </a>
    </div>
  </div>
</header>

<!-- Mobile Navigation Drawer -->
<div
  class="fixed inset-y-0 left-0 w-80 bg-white border-r border-slate-200 z-[100] -translate-x-full transition-transform duration-300 md:hidden"
  id="drawer"
>
  <div class="flex flex-col h-full">
    <div
      class="p-6 border-b border-slate-100 flex justify-between items-center bg-slate-50"
    >
      <div>
        <h2
          class="font-['Plus_Jakarta_Sans',sans-serif] text-lg font-bold text-slate-900"
        >
          MENU DE NAVEGAÇÃO
        </h2>
        <span class="font-['Space_Grotesk',monospace] text-xs text-slate-500"
          >KATUN DPS BRASIL & LATAM</span
        >
      </div>
      <button
        class="text-slate-500 hover:text-slate-900 cursor-crosshair"
        onclick="toggleDrawer()"
      >
        <span class="material-symbols-outlined text-2xl">close</span>
      </button>
    </div>

    <nav
      class="flex-grow flex flex-col p-4 space-y-1 font-['Plus_Jakarta_Sans',sans-serif] text-sm font-semibold text-slate-700"
    >
      <a
        id="mobile-nav-inicio"
        class="p-3 hover:bg-slate-100 transition-colors flex items-center gap-3 cursor-crosshair"
        href="/"
        onclick="toggleDrawer()"
      >
        <span class="material-symbols-outlined text-slate-400">home</span> Início
      </a>

      <!-- Sub-seções exibidas no mobile -->
      <div class="pl-6 space-y-1 border-l-2 border-slate-100 my-1">
        <a
          class="p-2 text-xs text-slate-600 hover:text-[#00aeef] flex items-center gap-2"
          href="/#specs"
          onclick="toggleDrawer()"
        >
          <span class="material-symbols-outlined text-xs">memory</span> Tecnologia Memjet & Laser
        </a>
        <a
          class="p-2 text-xs text-slate-600 hover:text-[#00aeef] flex items-center gap-2"
          href="/#industries"
          onclick="toggleDrawer()"
        >
          <span class="material-symbols-outlined text-xs">factory</span> Setores Industriais
        </a>
        <a
          class="p-2 text-xs text-slate-600 hover:text-[#00aeef] flex items-center gap-2"
          href="/#process"
          onclick="toggleDrawer()"
        >
          <span class="material-symbols-outlined text-xs">precision_manufacturing</span> Processo de Trabalho
        </a>
        <a
          class="p-2 text-xs text-slate-600 hover:text-[#00aeef] flex items-center gap-2"
          href="/#calculator"
          onclick="toggleDrawer()"
        >
          <span class="material-symbols-outlined text-xs">calculate</span> Simulador de ROI
        </a>
      </div>

      <a
        id="mobile-nav-catalogo"
        class="p-3 hover:bg-slate-100 transition-colors flex items-center gap-3 cursor-crosshair"
        href="/catalogo"
        onclick="toggleDrawer()"
      >
        <span class="material-symbols-outlined text-slate-400">inventory_2</span> Catálogo Completo
      </a>

      <a
        id="mobile-nav-industrias"
        class="p-3 hover:bg-slate-100 transition-colors flex items-center gap-3 cursor-crosshair"
        href="/industrias"
        onclick="toggleDrawer()"
      >
        <span class="material-symbols-outlined text-slate-400">factory</span> Indústrias & Setores
      </a>

      <a
        id="mobile-nav-blog"
        class="p-3 hover:bg-slate-100 transition-colors flex items-center gap-3 cursor-crosshair"
        href="/blog"
        onclick="toggleDrawer()"
      >
        <span class="material-symbols-outlined text-slate-400">article</span> Blog & Artigos
      </a>

      <a
        id="mobile-nav-contacto"
        class="p-3 hover:bg-slate-100 transition-colors flex items-center gap-3 cursor-crosshair"
        href="/contacto"
        onclick="toggleDrawer()"
      >
        <span class="material-symbols-outlined text-slate-400">mail</span> Fale com um Especialista
      </a>
    </nav>

    <div class="p-6 border-t border-slate-100 bg-slate-50 space-y-2">
      <p
        class="font-['Space_Grotesk',monospace] text-xs font-semibold text-slate-800"
      >
        ATENDIMENTO KATUN DPS BRASIL
      </p>
      <p class="text-xs text-slate-600">Eng. Cássio Rodrigues, MBA</p>
      <a 
        href="https://wa.me/5511945222069" 
        target="_blank" 
        rel="noopener"
        class="text-xs text-[#00aeef] font-bold block hover:underline"
      >
        WhatsApp: +55 (11) 94522-2069
      </a>
      <p class="text-[11px] text-slate-400">Tel: +55 11 3647-3284</p>
    </div>
  </div>
</div>

<!-- Active Link Highlighting Script -->
<script is:inline>
  function highlightActiveNav() {
    const currentPath = window.location.pathname.replace(/\/$/, "") || "/";

    const navInicio = document.getElementById("nav-inicio");
    const navCatalogo = document.getElementById("nav-catalogo");
    const navIndustrias = document.getElementById("nav-industrias");
    const navBlog = document.getElementById("nav-blog");
    const navContacto = document.getElementById("nav-contacto");

    const mNavInicio = document.getElementById("mobile-nav-inicio");
    const mNavCatalogo = document.getElementById("mobile-nav-catalogo");
    const mNavIndustrias = document.getElementById("mobile-nav-industrias");
    const mNavBlog = document.getElementById("mobile-nav-blog");
    const mNavContacto = document.getElementById("mobile-nav-contacto");

    const activeClasses = [
      "text-[#00aeef]",
      "font-extrabold",
      "border-b-2",
      "border-[#00aeef]",
    ];
    const mobileActiveClasses = [
      "bg-[#00aeef]/10",
      "text-[#00aeef]",
      "font-bold",
    ];

    // Clear active states
    [navInicio, navCatalogo, navIndustrias, navBlog, navContacto].forEach((el) => {
      if (el) {
        el.classList.remove(...activeClasses);
        el.classList.add("text-slate-600");
      }
    });

    [mNavInicio, mNavCatalogo, mNavIndustrias, mNavBlog, mNavContacto].forEach((el) => {
      if (el) {
        el.classList.remove(...mobileActiveClasses);
      }
    });

    // Apply active highlight based on current route
    if (currentPath === "/blog" || currentPath.startsWith("/blog")) {
      if (navBlog) {
        navBlog.classList.add(...activeClasses);
        navBlog.classList.remove("text-slate-600");
      }
      if (mNavBlog) mNavBlog.classList.add(...mobileActiveClasses);
    } else if (currentPath === "/catalogo" || currentPath.startsWith("/catalogo")) {
      if (navCatalogo) {
        navCatalogo.classList.add(...activeClasses);
        navCatalogo.classList.remove("text-slate-600");
      }
      if (mNavCatalogo) mNavCatalogo.classList.add(...mobileActiveClasses);
    } else if (
      currentPath === "/industrias" ||
      currentPath.startsWith("/industrias")
    ) {
      if (navIndustrias) {
        navIndustrias.classList.add(...activeClasses);
        navIndustrias.classList.remove("text-slate-600");
      }
      if (mNavIndustrias) mNavIndustrias.classList.add(...mobileActiveClasses);
    } else if (
      currentPath === "/contacto" ||
      currentPath.startsWith("/contacto")
    ) {
      if (navContacto) {
        navContacto.classList.add(...activeClasses);
        navContacto.classList.remove("text-slate-600");
      }
      if (mNavContacto) mNavContacto.classList.add(...mobileActiveClasses);
    } else if (currentPath === "/" || currentPath === "") {
      if (navInicio) {
        navInicio.classList.add(...activeClasses);
        navInicio.classList.remove("text-slate-600");
      }
      if (mNavInicio) mNavInicio.classList.add(...mobileActiveClasses);
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", highlightActiveNav);
  } else {
    highlightActiveNav();
  }

  // Mobile Drawer Toggle
  function toggleDrawer() {
    const drawer = document.getElementById("drawer");
    if (drawer) {
      drawer.classList.toggle("-translate-x-full");
    }
  }
</script>
