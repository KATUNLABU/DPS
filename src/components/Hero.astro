---
import { MACHINES } from '../data/machines';
const totalMachines = MACHINES.length;
---

<section id="hero" class="relative pt-28 pb-16 md:pt-36 md:pb-24 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
  
  <!-- Top Pill Badge (Square) -->
  <div class="flex justify-center mb-8 animate-hero-cascade delay-0">
    <div class="inline-flex items-center gap-2 px-4 py-1.5 bg-slate-100/80 border border-slate-200 text-slate-700 font-['Space_Grotesk',monospace] text-xs font-semibold shadow-xs rounded-none">
      <span class="w-2 h-2 bg-[#00aeef] animate-pulse"></span>
      <span>KATUN Digital Printing Solutions ™ • Brasil & América Latina</span>
    </div>
  </div>

  <!-- Main Headline & Description in Portuguese -->
  <div class="text-center max-w-4xl mx-auto space-y-6 mb-16">
    <h1 class="font-['Plus_Jakarta_Sans',sans-serif] text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight text-slate-900 leading-[1.06] animate-hero-cascade delay-150">
      SOLUÇÕES EM <br class="hidden sm:inline" />
      <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#00aeef] via-[#e11d48] to-[#f59e0b]">
        IMPRESSÃO DIGITAL
      </span>
    </h1>

    <h2 class="font-['Space_Grotesk',monospace] text-base sm:text-xl font-bold text-slate-800 tracking-wide uppercase animate-hero-cascade delay-300">
      Equipamentos de Impressão Digital e Corte de Rótulos e Etiquetas
    </h2>

    <p class="text-slate-600 text-sm sm:text-lg font-normal max-w-2xl mx-auto leading-relaxed animate-hero-cascade delay-450">
      Somos especialistas na distribuição e suporte técnico de soluções industriais de alta precisão para impressão em bobina, corte a laser CO2, lâmina tangencial e acabamento de rótulos autoadesivos.
    </p>

    <!-- Specialized Equipment Pillars List -->
    <div class="flex flex-wrap justify-center gap-2 max-w-3xl mx-auto pt-2 font-['Space_Grotesk',monospace] text-xs font-semibold text-slate-700 animate-hero-cascade delay-600">
      <span class="px-3 py-1.5 bg-white border border-slate-200 rounded-none shadow-2xs">• Impressoras Digitais de Rótulos (Bobina)</span>
      <span class="px-3 py-1.5 bg-white border border-slate-200 rounded-none shadow-2xs">• Cortadoras (Lâmina Tangencial / Laser CO2)</span>
      <span class="px-3 py-1.5 bg-white border border-slate-200 rounded-none shadow-2xs">• Prensas Híbridas & Fusão LED</span>
      <span class="px-3 py-1.5 bg-white border border-slate-200 rounded-none shadow-2xs">• Contadores & Rebobinadores de Precisão</span>
      <span class="px-3 py-1.5 bg-white border border-slate-200 rounded-none shadow-2xs">• Suporte Especializado Katun</span>
    </div>

    <!-- Action Buttons (Square) -->
    <div class="flex flex-wrap justify-center gap-4 pt-4 animate-hero-cascade delay-750">
      <a 
        href="/catalogo" 
        class="w-full sm:w-auto px-8 py-4 bg-slate-900 hover:bg-[#00aeef] text-white font-semibold text-sm transition-all shadow-sm flex items-center justify-center gap-2 rounded-none cursor-crosshair uppercase"
      >
        <span>CONHEÇA NOSSOS EQUIPAMENTOS ({totalMachines})</span>
        <span class="material-symbols-outlined text-sm">arrow_forward</span>
      </a>
      <a 
        href="#calculator" 
        class="w-full sm:w-auto px-8 py-4 bg-white hover:bg-slate-100 text-slate-700 font-semibold text-sm border border-slate-200 transition-all flex items-center justify-center gap-2 rounded-none cursor-crosshair uppercase"
      >
        <span class="material-symbols-outlined text-sm text-[#00aeef]">calculate</span>
        <span>SIMULADOR DE ROI</span>
      </a>
    </div>
  </div>

  <!-- Lower Hero: 3 Real Equipment Featured Cards (Zero Placeholders, Real Models!) -->
  <div class="space-y-6 pt-4 animate-hero-cascade delay-900">
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 pb-3 border-b border-slate-200">
      <h3 class="font-['Plus_Jakarta_Sans',sans-serif] text-xl sm:text-2xl font-bold text-slate-900 uppercase">
        EQUIPAMENTOS EM DESTAQUE
      </h3>
      <a href="/catalogo" class="font-['Space_Grotesk',monospace] text-xs font-bold text-[#00aeef] hover:underline flex items-center gap-1 cursor-crosshair">
        VER CATÁLOGO COMPLETO ({totalMachines}) ↗
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      
      <!-- Card 1: ArrowJet Aqua 330R (Real Photo) -->
      <div class="bg-white p-6 border border-slate-200 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col justify-between group space-y-6 rounded-none">
        <div class="space-y-4">
          <!-- Image Preview -->
          <div class="relative h-48 overflow-hidden bg-slate-100 rounded-none">
            <img 
              src="/imagenes/CATALOGO_IMAGENES_WEB/01_Impresoras_Digitales/03_ArrowJet_Aqua_330R/arrowjet-aqua-330r-principal-2025.webp" 
              alt="ArrowJet Aqua 330R - Impressora Digital Rolo a Rolo" 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            />
            <span class="absolute top-3 left-3 bg-white/90 backdrop-blur-md text-[#00aeef] font-['Space_Grotesk',monospace] text-[11px] font-bold px-3 py-1 border border-slate-200 shadow-xs rounded-none">
              MEMJET® DURAFLEX®
            </span>
          </div>

          <div class="space-y-2">
            <h4 class="font-['Plus_Jakarta_Sans',sans-serif] text-xl font-bold text-slate-900 group-hover:text-[#00aeef] transition-colors">
              ArrowJet Aqua 330R
            </h4>
            <p class="text-xs text-slate-500 font-['Space_Grotesk',monospace]">
              Prensa digital de passagem única (single-pass) com cabeçote motorizado Memjet DuraFlex® e secagem NIR.
            </p>
          </div>

          <!-- Spec Pills Grid -->
          <div class="grid grid-cols-2 gap-2 p-3 bg-slate-50 border border-slate-100 font-['Space_Grotesk',monospace] text-[11px] rounded-none">
            <div>
              <span class="text-slate-400 block text-[10px]">RESOLUÇÃO</span>
              <span class="font-bold text-slate-800">1600 DPI</span>
            </div>
            <div>
              <span class="text-slate-400 block text-[10px]">VELOCIDADE</span>
              <span class="font-bold text-[#00aeef]">Até 21 m/min</span>
            </div>
          </div>
        </div>

        <a href="/solucion/arrowjet-aqua-330r" class="w-full py-3 px-4 bg-slate-100 hover:bg-slate-900 hover:text-white text-slate-800 font-['Space_Grotesk',monospace] text-xs font-semibold text-center transition-colors block rounded-none cursor-crosshair uppercase">
          VER DETALHES TÉCNICOS ↗
        </a>
      </div>

      <!-- Card 2: Taurus 35 PL Plus Láser CO2 (Real Photo, Real Specs!) -->
      <div class="bg-white p-6 border border-slate-200 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col justify-between group space-y-6 rounded-none">
        <div class="space-y-4">
          <!-- Image Preview -->
          <div class="relative h-48 overflow-hidden bg-slate-100 rounded-none">
            <img 
              src="/imagenes/CATALOGO_IMAGENES_WEB/02_Cortadoras_y_Finalizadoras/06_Taurus_35_PL_Plus_Laser_CO2/taurus-35-pl-plus-laser-co2-principal.webp" 
              alt="Taurus 35 PL Plus - Cortadora a Laser CO2 Industrial" 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            />
            <span class="absolute top-3 left-3 bg-white/90 backdrop-blur-md text-[#e11d48] font-['Space_Grotesk',monospace] text-[11px] font-bold px-3 py-1 border border-slate-200 shadow-xs rounded-none">
              CORTE A LASER CO2
            </span>
          </div>

          <div class="space-y-2">
            <h4 class="font-['Plus_Jakarta_Sans',sans-serif] text-xl font-bold text-slate-900 group-hover:text-[#e11d48] transition-colors">
              Taurus 35 PL Plus Láser
            </h4>
            <p class="text-xs text-slate-500 font-['Space_Grotesk',monospace]">
              Finalizadora digital a laser CO2 de até 350W com mesa de vácuo, corte óptico sem matriz e laminação.
            </p>
          </div>

          <!-- Spec Pills Grid -->
          <div class="grid grid-cols-2 gap-2 p-3 bg-slate-50 border border-slate-100 font-['Space_Grotesk',monospace] text-[11px] rounded-none">
            <div>
              <span class="text-slate-400 block text-[10px]">VELOCIDADE</span>
              <span class="font-bold text-[#e11d48]">Até 70 m/min</span>
            </div>
            <div>
              <span class="text-slate-400 block text-[10px]">POTÊNCIA</span>
              <span class="font-bold text-slate-800">150W - 350W</span>
            </div>
          </div>
        </div>

        <a href="/solucion/taurus-pl-series" class="w-full py-3 px-4 bg-slate-100 hover:bg-slate-900 hover:text-white text-slate-800 font-['Space_Grotesk',monospace] text-xs font-semibold text-center transition-colors block rounded-none cursor-crosshair uppercase">
          VER DETALHES TÉCNICOS ↗
        </a>
      </div>

      <!-- Card 3: VIPColor VP660 / VP610 (Real Photo) -->
      <div class="bg-white p-6 border border-slate-200 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col justify-between group space-y-6 rounded-none">
        <div class="space-y-4">
          <!-- Image Preview -->
          <div class="relative h-48 overflow-hidden bg-slate-100 rounded-none">
            <img 
              src="/imagenes/CATALOGO_IMAGENES_WEB/01_Impresoras_Digitales/01_VIP_Color_VP660_VP610/vipcolor-vp660-roll-to-roll-principal.webp" 
              alt="VIP Color VP660 / VP610 - Impressora Digital de Mesa" 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            />
            <span class="absolute top-3 left-3 bg-white/90 backdrop-blur-md text-[#f59e0b] font-['Space_Grotesk',monospace] text-[11px] font-bold px-3 py-1 border border-slate-200 shadow-xs rounded-none">
              MESA INDUSTRIAL
            </span>
          </div>

          <div class="space-y-2">
            <h4 class="font-['Plus_Jakarta_Sans',sans-serif] text-xl font-bold text-slate-900 group-hover:text-[#f59e0b] transition-colors">
              VIP Color VP660 / VP610
            </h4>
            <p class="text-xs text-slate-500 font-['Space_Grotesk',monospace]">
              Impressora digital Memjet Versapass® para rótulos coloridos sob demanda com acabamento resistente.
            </p>
          </div>

          <!-- Spec Pills Grid -->
          <div class="grid grid-cols-2 gap-2 p-3 bg-slate-50 border border-slate-100 font-['Space_Grotesk',monospace] text-[11px] rounded-none">
            <div>
              <span class="text-slate-400 block text-[10px]">CAPACIDADE</span>
              <span class="font-bold text-[#f59e0b]">2,4K rot/10min</span>
            </div>
            <div>
              <span class="text-slate-400 block text-[10px]">TINTAS</span>
              <span class="font-bold text-slate-800">250ml CMYK</span>
            </div>
          </div>
        </div>

        <a href="/solucion/vipcolor-vp610-vp660" class="w-full py-3 px-4 bg-slate-100 hover:bg-slate-900 hover:text-white text-slate-800 font-['Space_Grotesk',monospace] text-xs font-semibold text-center transition-colors block rounded-none cursor-crosshair uppercase">
          VER DETALHES TÉCNICOS ↗
        </a>
      </div>

    </div>
  </div>
</section>
