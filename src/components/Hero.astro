---
---

<section id="hero" class="relative pt-28 pb-16 md:pt-36 md:pb-24 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
  
  <!-- Top Pill Badge (Square) -->
  <div class="flex justify-center mb-8">
    <div class="inline-flex items-center gap-2 px-4 py-1.5 bg-slate-100/80 border border-slate-200 text-slate-700 font-['Space_Grotesk',monospace] text-xs font-semibold shadow-xs rounded-none">
      <span class="w-2 h-2 bg-[#00aeef] animate-pulse"></span>
      <span>KATUN Digital Printing Solutions ™</span>
    </div>
  </div>

  <!-- Main Headline & Description -->
  <div class="text-center max-w-4xl mx-auto space-y-6 mb-16">
    <h1 class="font-['Plus_Jakarta_Sans',sans-serif] text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight text-slate-900 leading-[1.06]">
      SOLUCIONES EN <br class="hidden sm:inline" />
      <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#00aeef] via-[#e11d48] to-[#f59e0b]">
        IMPRESIÓN DIGITAL
      </span>
    </h1>

    <h2 class="font-['Space_Grotesk',monospace] text-base sm:text-xl font-bold text-slate-800 tracking-wide uppercase">
      Equipos de Impresión Digital y Corte de Etiquetas y Empaques
    </h2>

    <p class="text-slate-600 text-sm sm:text-lg font-normal max-w-2xl mx-auto leading-relaxed">
      Nos especializamos en la fabricación y distribución de equipos y máquinas digitales de impresión y corte para las industrias.
    </p>

    <!-- Specialized Equipment Pillars List -->
    <div class="flex flex-wrap justify-center gap-2 max-w-3xl mx-auto pt-2 font-['Space_Grotesk',monospace] text-xs font-semibold text-slate-700">
      <span class="px-3 py-1.5 bg-white border border-slate-200 rounded-none shadow-2xs">• Impresoras Digitales de Etiquetas</span>
      <span class="px-3 py-1.5 bg-white border border-slate-200 rounded-none shadow-2xs">• Cortadoras (Cuchillas / Láser)</span>
      <span class="px-3 py-1.5 bg-white border border-slate-200 rounded-none shadow-2xs">• Transferencia Térmica & Foil</span>
      <span class="px-3 py-1.5 bg-white border border-slate-200 rounded-none shadow-2xs">• Impresoras para Corrugados & Madera</span>
      <span class="px-3 py-1.5 bg-white border border-slate-200 rounded-none shadow-2xs">• Consumibles & Refacciones</span>
    </div>

    <!-- Clean Action Buttons (Square) -->
    <div class="flex flex-wrap justify-center gap-4 pt-4">
      <a 
        href="/catalogo" 
        class="px-8 py-4 bg-slate-900 hover:bg-[#00aeef] text-white font-semibold text-sm transition-all shadow-sm flex items-center gap-2 rounded-none cursor-crosshair"
      >
        <span>CONOCE NUESTROS EQUIPOS ESPECIALIZADOS (14)</span>
        <span class="material-symbols-outlined text-sm">arrow_forward</span>
      </a>
      <a 
        href="#calculator" 
        class="px-8 py-4 bg-white hover:bg-slate-100 text-slate-700 font-semibold text-sm border border-slate-200 transition-all flex items-center gap-2 rounded-none cursor-crosshair"
      >
        <span class="material-symbols-outlined text-sm text-[#00aeef]">calculate</span>
        <span>SIMULADOR DE ROI</span>
      </a>
    </div>
  </div>

  <!-- Lower Hero: 3-Card Minimalist Equipment Triad (Sharp Square 0px Radius) -->
  <div class="space-y-6 pt-4">
    <div class="flex justify-between items-center pb-3 border-b border-slate-200">
      <h3 class="font-['Plus_Jakarta_Sans',sans-serif] text-2xl font-bold text-slate-900">
        EQUIPOS ESPECIALIZADOS DESTACADOS
      </h3>
      <a href="/catalogo" class="font-['Space_Grotesk',monospace] text-xs font-bold text-[#00aeef] hover:underline flex items-center gap-1 cursor-crosshair">
        VER CATÁLOGO COMPLETO (14) ↗
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      
      <!-- Card 1: ArrowJet Aqua 330R -->
      <div class="bg-white p-6 border border-slate-200 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col justify-between group space-y-6 rounded-none">
        <div class="space-y-4">
          <!-- Image Preview -->
          <div class="relative h-48 overflow-hidden bg-slate-100 rounded-none">
            <img 
              src="https://images.unsplash.com/photo-1562654501-a0ccc0fc3fb1?auto=format&fit=crop&w=800&q=80" 
              alt="ArrowJet Aqua 330R" 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            />
            <span class="absolute top-3 left-3 bg-white/90 backdrop-blur-md text-[#00aeef] font-['Space_Grotesk',monospace] text-[11px] font-bold px-3 py-1 border border-slate-200 shadow-xs rounded-none">
              MEMJET® DURAFLEX®
            </span>
          </div>

          <div class="space-y-2">
            <h4 class="font-['Plus_Jakarta_Sans',sans-serif] text-xl font-bold text-slate-900 group-hover:text-[#00aeef] transition-colors">
              ArrowJet Aqua 330R
            </h4>
            <p class="text-xs text-slate-500 font-['Space_Grotesk',monospace]">
              Prensa digital de una sola pasada con cabezales motorizados DuraFlex® de Memjet.
            </p>
          </div>

          <!-- Spec Pills Grid -->
          <div class="grid grid-cols-2 gap-2 p-3 bg-slate-50 border border-slate-100 font-['Space_Grotesk',monospace] text-[11px] rounded-none">
            <div>
              <span class="text-slate-400 block text-[10px]">RESOLUCIÓN</span>
              <span class="font-bold text-slate-800">1600 DPI</span>
            </div>
            <div>
              <span class="text-slate-400 block text-[10px]">VELOCIDAD</span>
              <span class="font-bold text-[#00aeef]">21 m/min</span>
            </div>
          </div>
        </div>

        <a href="/catalogo" class="w-full py-3 px-4 bg-slate-100 hover:bg-slate-900 hover:text-white text-slate-800 font-['Space_Grotesk',monospace] text-xs font-semibold text-center transition-colors block rounded-none cursor-crosshair">
          VER EN CATÁLOGO ↗
        </a>
      </div>

      <!-- Card 2: Cortadora Láser LC 350 PM -->
      <div class="bg-white p-6 border border-slate-200 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col justify-between group space-y-6 rounded-none">
        <div class="space-y-4">
          <!-- Image Preview -->
          <div class="relative h-48 overflow-hidden bg-slate-100 rounded-none">
            <img 
              src="https://images.unsplash.com/photo-1504917599217-d4dc5ebe6122?auto=format&fit=crop&w=800&q=80" 
              alt="Cortadora Láser LC 350 PM" 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            />
            <span class="absolute top-3 left-3 bg-white/90 backdrop-blur-md text-[#e11d48] font-['Space_Grotesk',monospace] text-[11px] font-bold px-3 py-1 border border-slate-200 shadow-xs rounded-none">
              CORTE LÁSER 150W
            </span>
          </div>

          <div class="space-y-2">
            <h4 class="font-['Plus_Jakarta_Sans',sans-serif] text-xl font-bold text-slate-900 group-hover:text-[#e11d48] transition-colors">
              Cortadora LC 350 PM
            </h4>
            <p class="text-xs text-slate-500 font-['Space_Grotesk',monospace]">
              Cabezal de corte láser de alta potencia sin troqueles mecánicos con lectura QR.
            </p>
          </div>

          <!-- Spec Pills Grid -->
          <div class="grid grid-cols-2 gap-2 p-3 bg-slate-50 border border-slate-100 font-['Space_Grotesk',monospace] text-[11px] rounded-none">
            <div>
              <span class="text-slate-400 block text-[10px]">VELOCIDAD</span>
              <span class="font-bold text-[#e11d48]">80 m/min</span>
            </div>
            <div>
              <span class="text-slate-400 block text-[10px]">CILINDROS</span>
              <span class="font-bold text-slate-800">Cero Placas</span>
            </div>
          </div>
        </div>

        <a href="/catalogo" class="w-full py-3 px-4 bg-slate-100 hover:bg-slate-900 hover:text-white text-slate-800 font-['Space_Grotesk',monospace] text-xs font-semibold text-center transition-colors block rounded-none cursor-crosshair">
          VER EN CATÁLOGO ↗
        </a>
      </div>

      <!-- Card 3: VIPColor VP610 / VP660 -->
      <div class="bg-white p-6 border border-slate-200 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col justify-between group space-y-6 rounded-none">
        <div class="space-y-4">
          <!-- Image Preview -->
          <div class="relative h-48 overflow-hidden bg-slate-100 rounded-none">
            <img 
              src="https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?auto=format&fit=crop&w=800&q=80" 
              alt="VIPColor VP610 / VP660" 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            />
            <span class="absolute top-3 left-3 bg-white/90 backdrop-blur-md text-[#f59e0b] font-['Space_Grotesk',monospace] text-[11px] font-bold px-3 py-1 border border-slate-200 shadow-xs rounded-none">
              ESCRITORIO PRO
            </span>
          </div>

          <div class="space-y-2">
            <h4 class="font-['Plus_Jakarta_Sans',sans-serif] text-xl font-bold text-slate-900 group-hover:text-[#f59e0b] transition-colors">
              VIPColor VP610 / VP660
            </h4>
            <p class="text-xs text-slate-500 font-['Space_Grotesk',monospace]">
              Impresoras de tinta digitales para etiquetas a color bajo demanda.
            </p>
          </div>

          <!-- Spec Pills Grid -->
          <div class="grid grid-cols-2 gap-2 p-3 bg-slate-50 border border-slate-100 font-['Space_Grotesk',monospace] text-[11px] rounded-none">
            <div>
              <span class="text-slate-400 block text-[10px]">CAPACIDAD</span>
              <span class="font-bold text-[#f59e0b]">2.4K etiq/10m</span>
            </div>
            <div>
              <span class="text-slate-400 block text-[10px]">TINTAS</span>
              <span class="font-bold text-slate-800">250ml CMYK</span>
            </div>
          </div>
        </div>

        <a href="/catalogo" class="w-full py-3 px-4 bg-slate-100 hover:bg-slate-900 hover:text-white text-slate-800 font-['Space_Grotesk',monospace] text-xs font-semibold text-center transition-colors block rounded-none cursor-crosshair">
          VER EN CATÁLOGO ↗
        </a>
      </div>

    </div>
  </div>
</section>
