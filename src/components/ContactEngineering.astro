---
---

<section id="contact" class="py-16 sm:py-24 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto border-t border-slate-200">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-stretch">
    <!-- Left Column: Form (Square) -->
    <div class="lg:col-span-7 bg-white p-6 sm:p-10 border border-slate-200 shadow-sm space-y-6 flex flex-col justify-between rounded-none">
      <div>
        <span class="font-['Space_Grotesk',monospace] text-xs font-semibold px-3.5 py-1.5 bg-[#00aeef]/10 text-[#00aeef] inline-block mb-4 rounded-none">
          CONTACTO DIRECTO
        </span>
        <h2 class="font-['Plus_Jakarta_Sans',sans-serif] text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight mb-2">
          Contactar con Ingeniería Katun DPS
        </h2>
        <p class="text-slate-600 text-xs sm:text-sm font-['Space_Grotesk',monospace]">
          Solicita una cotización, agenda una demostración en vivo en nuestro showroom o solicita muestras impresas.
        </p>
      </div>

      <form class="space-y-5" id="contact-form">
        <div>
          <label class="font-['Space_Grotesk',monospace] text-xs font-semibold text-slate-700 block mb-1.5">
            Nombre Completo *
          </label>
          <input 
            type="text" 
            required 
            placeholder="Ing. Carlos Mendoza" 
            class="w-full bg-slate-50 border border-slate-200 px-4 py-3 font-['Plus_Jakarta_Sans',sans-serif] text-sm text-slate-900 focus:bg-white focus:ring-2 focus:ring-[#00aeef] focus:outline-none placeholder:text-slate-400 rounded-none cursor-crosshair"
          />
        </div>

        <div>
          <label class="font-['Space_Grotesk',monospace] text-xs font-semibold text-slate-700 block mb-1.5">
            Empresa / Corporativo *
          </label>
          <input 
            type="text" 
            required 
            placeholder="Etiquetas e Impresiones S.A." 
            class="w-full bg-slate-50 border border-slate-200 px-4 py-3 font-['Plus_Jakarta_Sans',sans-serif] text-sm text-slate-900 focus:bg-white focus:ring-2 focus:ring-[#00aeef] focus:outline-none placeholder:text-slate-400 rounded-none cursor-crosshair"
          />
        </div>

        <div>
          <label class="font-['Space_Grotesk',monospace] text-xs font-semibold text-slate-700 block mb-1.5">
            Correo Electrónico *
          </label>
          <input 
            type="email" 
            required 
            placeholder="contacto@empresa.com" 
            class="w-full bg-slate-50 border border-slate-200 px-4 py-3 font-['Plus_Jakarta_Sans',sans-serif] text-sm text-slate-900 focus:bg-white focus:ring-2 focus:ring-[#00aeef] focus:outline-none placeholder:text-slate-400 rounded-none cursor-crosshair"
          />
        </div>

        <div>
          <label class="font-['Space_Grotesk',monospace] text-xs font-semibold text-slate-700 block mb-1.5">
            Equipo de Interés
          </label>
          <select class="w-full bg-slate-50 border border-slate-200 px-4 py-3 font-['Plus_Jakarta_Sans',sans-serif] text-sm text-slate-900 focus:bg-white focus:ring-2 focus:ring-[#00aeef] focus:outline-none cursor-crosshair rounded-none">
            <option value="ArrowJet Aqua 330R">ArrowJet Aqua 330R (Prensa Memjet)</option>
            <option value="VIPColor VP610/660">VIPColor VP610 / VP660 (Escritorio)</option>
            <option value="LC 350 PM Laser">Cortadora Láser CO2 LC 350 PM</option>
            <option value="Aqua Jet 330 Hybrid">Aqua Jet 330 Hybrid Pro M</option>
            <option value="Katun LT330">Katun LT330 Digital Press</option>
            <option value="Otros Equipos">Otros Equipos / Asesoría General</option>
          </select>
        </div>

        <button 
          type="submit" 
          class="w-full bg-slate-900 hover:bg-[#00aeef] text-white py-4 font-semibold text-sm transition-all shadow-xs flex items-center justify-center gap-2 cursor-crosshair rounded-none"
        >
          <span>ENVIAR SOLICITUD DE COTIZACIÓN</span>
          <span class="material-symbols-outlined text-sm">send</span>
        </button>

        <div id="form-status" class="hidden p-3 font-['Space_Grotesk',monospace] text-xs font-semibold bg-emerald-50 border border-emerald-200 text-emerald-700 rounded-none">
          ✓ Solicitud enviada correctamente. Un ingeniero de Katun DPS se pondrá en contacto a la brevedad.
        </div>
      </form>
    </div>

    <!-- Right Column: Sign-off Card (Square) -->
    <div class="lg:col-span-5 bg-slate-900 p-6 sm:p-10 text-white flex flex-col justify-between space-y-8 shadow-xl relative overflow-hidden rounded-none">
      <div class="space-y-6 relative z-10">
        <span class="font-['Space_Grotesk',monospace] text-xs font-semibold text-[#00aeef] bg-[#00aeef]/10 px-3 py-1 border border-[#00aeef]/20 inline-block rounded-none">
          CERTIFICACIÓN QA
        </span>

        <div class="p-6 bg-slate-800/80 border border-slate-700 space-y-4 backdrop-blur-md rounded-none">
          <div class="flex justify-between items-start">
            <div>
              <h4 class="font-['Plus_Jakarta_Sans',sans-serif] text-xl font-bold text-white">
                INSPECTION PASSED
              </h4>
              <span class="font-['Space_Grotesk',monospace] text-xs text-[#00aeef]">
                CERTIFICATE ID: #4092-XJ
              </span>
            </div>
            <span class="material-symbols-outlined text-3xl text-emerald-400">verified</span>
          </div>

          <div class="grid grid-cols-2 gap-3 text-xs font-['Space_Grotesk',monospace]">
            <div class="p-3 bg-slate-900/60 border border-slate-700 rounded-none">
              <span class="text-slate-400 block text-[10px]">QA STATUS</span>
              <span class="font-bold text-emerald-400">NOMINAL [100%]</span>
            </div>
            <div class="p-3 bg-slate-900/60 border border-slate-700 rounded-none">
              <span class="text-slate-400 block text-[10px]">BATCH RUN</span>
              <span class="font-bold text-[#e11d48]">ALPHA SET 2026</span>
            </div>
          </div>
        </div>
      </div>

      <!-- CMYK Palette Indicators (Square) -->
      <div class="space-y-2 relative z-10">
        <span class="font-['Space_Grotesk',monospace] text-[10px] text-slate-400 font-semibold uppercase block">
          CALIBRACIÓN DE PROCESO CMYK:
        </span>
        <div class="flex gap-3">
          <div class="w-8 h-8 bg-[#00AEEF] border border-white/20 shadow-xs rounded-none" title="Cyan"></div>
          <div class="w-8 h-8 bg-[#E11D48] border border-white/20 shadow-xs rounded-none" title="Magenta"></div>
          <div class="w-8 h-8 bg-[#F59E0B] border border-white/20 shadow-xs rounded-none" title="Yellow"></div>
          <div class="w-8 h-8 bg-slate-950 border border-white/20 shadow-xs rounded-none" title="Black"></div>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('contact-form');
    const statusMsg = document.getElementById('form-status');

    if (form) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        if (statusMsg) {
          statusMsg.classList.remove('hidden');
          form.reset();
          setTimeout(() => {
            statusMsg.classList.add('hidden');
          }, 8000);
        }
      });
    }
  });
</script>
