---
---

<section id="contact" class="py-16 sm:py-24 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto border-t border-slate-200 scroll-mt-20">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-stretch">
    <!-- Left Column: Form (Square) -->
    <div class="lg:col-span-7 bg-white p-6 sm:p-10 border border-slate-200 shadow-sm space-y-6 flex flex-col justify-between rounded-none">
      <div>
        <span class="font-['Space_Grotesk',monospace] text-xs font-semibold px-3.5 py-1.5 bg-[#00aeef]/10 text-[#00aeef] inline-block mb-4 rounded-none uppercase">
          CONTATO DIRETO
        </span>
        <h2 class="font-['Plus_Jakarta_Sans',sans-serif] text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight mb-2">
          Fale com um Especialista Katun DPS
        </h2>
        <p class="text-slate-600 text-xs sm:text-sm font-['Space_Grotesk',monospace]">
          Solicite uma cotação personalizada, agende uma demonstração prática ou peça um pacote de amostras físicas de rótulos impressos e cortados.
        </p>
      </div>

      <form class="space-y-5" id="contact-form">
        <div>
          <label class="font-['Space_Grotesk',monospace] text-xs font-semibold text-slate-700 block mb-1.5">
            Nome Completo *
          </label>
          <input 
            type="text" 
            required 
            placeholder="Ex.: Carlos Eduardo Silva" 
            class="w-full bg-slate-50 border border-slate-200 px-4 py-3 font-['Plus_Jakarta_Sans',sans-serif] text-sm text-slate-900 focus:bg-white focus:ring-2 focus:ring-[#00aeef] focus:outline-none placeholder:text-slate-400 rounded-none cursor-crosshair"
          />
        </div>

        <div>
          <label class="font-['Space_Grotesk',monospace] text-xs font-semibold text-slate-700 block mb-1.5">
            Empresa / Gráfica / Convertedor *
          </label>
          <input 
            type="text" 
            required 
            placeholder="Ex.: Rótulos & Embalagens Ltda." 
            class="w-full bg-slate-50 border border-slate-200 px-4 py-3 font-['Plus_Jakarta_Sans',sans-serif] text-sm text-slate-900 focus:bg-white focus:ring-2 focus:ring-[#00aeef] focus:outline-none placeholder:text-slate-400 rounded-none cursor-crosshair"
          />
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="font-['Space_Grotesk',monospace] text-xs font-semibold text-slate-700 block mb-1.5">
              E-mail Corporativo *
            </label>
            <input 
              type="email" 
              required 
              placeholder="contato@empresa.com.br" 
              class="w-full bg-slate-50 border border-slate-200 px-4 py-3 font-['Plus_Jakarta_Sans',sans-serif] text-sm text-slate-900 focus:bg-white focus:ring-2 focus:ring-[#00aeef] focus:outline-none placeholder:text-slate-400 rounded-none cursor-crosshair"
            />
          </div>
          <div>
            <label class="font-['Space_Grotesk',monospace] text-xs font-semibold text-slate-700 block mb-1.5">
              Telefone / WhatsApp *
            </label>
            <input 
              type="tel" 
              required 
              placeholder="(11) 99999-9999" 
              class="w-full bg-slate-50 border border-slate-200 px-4 py-3 font-['Plus_Jakarta_Sans',sans-serif] text-sm text-slate-900 focus:bg-white focus:ring-2 focus:ring-[#00aeef] focus:outline-none placeholder:text-slate-400 rounded-none cursor-crosshair"
            />
          </div>
        </div>

        <div>
          <label class="font-['Space_Grotesk',monospace] text-xs font-semibold text-slate-700 block mb-1.5">
            Equipamento de Interesse
          </label>
          <select class="w-full bg-slate-50 border border-slate-200 px-4 py-3 font-['Plus_Jakarta_Sans',sans-serif] text-sm text-slate-900 focus:bg-white focus:ring-2 focus:ring-[#00aeef] focus:outline-none cursor-crosshair rounded-none">
            <option value="ArrowJet Aqua 330R">ArrowJet Aqua 330R (Prensa Memjet DuraFlex)</option>
            <option value="Taurus 35 PL Plus Laser">Taurus 35 PL Plus (Corte a Laser CO2 Industrial)</option>
            <option value="VIPColor VP660 / VP610">VIP Color VP660 / VP610 (Impressora de Mesa)</option>
            <option value="Cortadora LC 350 PM">Cortadora de Rótulos por Folha LC 350 PM</option>
            <option value="Cortadora KF30X">Cortadora KF30X (Lâmina Tangencial Rolo a Rolo)</option>
            <option value="Arrow EzCut 350R">Arrow EzCut 350R (Lâminas Múltiplas Contínuas)</option>
            <option value="Gemini 40">Gemini 40 (Finalizadora em Folha B3 Graphtec)</option>
            <option value="Katun DPS LT330">Katun DPS LT330 (Digital LED CMYK + Branco)</option>
            <option value="Outros Equipamentos">Outros Equipamentos / Consultoria Geral</option>
          </select>
        </div>

        <button 
          type="submit" 
          class="w-full bg-slate-900 hover:bg-[#00aeef] text-white py-4 font-semibold text-sm transition-all shadow-xs flex items-center justify-center gap-2 cursor-crosshair rounded-none uppercase"
        >
          <span>ENVIAR SOLICITAÇÃO DE COTAÇÃO</span>
          <span class="material-symbols-outlined text-sm">send</span>
        </button>

        <div id="form-status" class="hidden p-3 font-['Space_Grotesk',monospace] text-xs font-semibold bg-emerald-50 border border-emerald-200 text-emerald-700 rounded-none">
          ✓ Solicitação enviada com sucesso! Um especialista da Katun DPS entrará em contato em breve.
        </div>
      </form>
    </div>

    <!-- Right Column: Specialist Info & Direct Contact Card -->
    <div class="lg:col-span-5 bg-slate-900 p-6 sm:p-10 text-white flex flex-col justify-between space-y-8 shadow-xl relative overflow-hidden rounded-none">
      <div class="space-y-6 relative z-10">
        <span class="font-['Space_Grotesk',monospace] text-xs font-semibold text-[#00aeef] bg-[#00aeef]/10 px-3 py-1 border border-[#00aeef]/20 inline-block rounded-none uppercase">
          ESPECIALISTA KATUN DPS BRASIL
        </span>

        <div class="p-6 bg-slate-800/80 border border-slate-700 space-y-4 backdrop-blur-md rounded-none">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 bg-[#00aeef]/20 border border-[#00aeef]/40 flex items-center justify-center text-[#00aeef] shrink-0 font-bold text-lg">
              CR
            </div>
            <div>
              <h4 class="font-['Plus_Jakarta_Sans',sans-serif] text-lg font-bold text-white">
                Eng. Cássio Rodrigues, MBA
              </h4>
              <p class="font-['Space_Grotesk',monospace] text-xs text-[#00aeef] font-semibold">
                Brazil – CTS / New Product Development • DPS Division Expert
              </p>
            </div>
          </div>

          <div class="space-y-2.5 pt-2 text-xs font-['Space_Grotesk',monospace] text-slate-300">
            <div class="flex items-center gap-2">
              <span class="material-symbols-outlined text-[#00aeef] text-sm">chat</span>
              <span>WhatsApp Corporativo:</span>
              <a href="https://wa.me/5511945222069" target="_blank" rel="noopener" class="text-[#00aeef] font-bold hover:underline">
                +55 (11) 94522-2069
              </a>
            </div>
            <div class="flex items-center gap-2">
              <span class="material-symbols-outlined text-slate-400 text-sm">call</span>
              <span>Telefone Fixo:</span>
              <span class="text-white">+55 (11) 3647-3284</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="material-symbols-outlined text-slate-400 text-sm">mail</span>
              <span>E-mail:</span>
              <a href="mailto:cassio.rodrigues@katun.com" class="text-white hover:underline">cassio.rodrigues@katun.com</a>
            </div>
          </div>

          <div class="pt-3 border-t border-slate-700/60">
            <a 
              href="https://wa.me/5511945222069?text=Ol%C3%A1%20C%C3%A1ssio%2C%20gostaria%20de%20informa%C3%A7%C3%B5es%20t%C3%A9cnicas%20sobre%20os%20equipamentos%20Katun%20DPS"
              target="_blank" 
              rel="noopener"
              class="w-full bg-[#00aeef] hover:bg-[#009ee2] text-white py-3 px-4 text-xs font-bold font-['Space_Grotesk',monospace] transition-colors flex items-center justify-center gap-2 shadow-xs uppercase"
            >
              <span class="material-symbols-outlined text-base">chat</span>
              FALAR DIRETO COM CÁSSIO NO WHATSAPP
            </a>
          </div>
        </div>

        <div class="p-4 bg-slate-800/40 border border-slate-800 text-xs font-['Space_Grotesk',monospace] text-slate-400">
          <span class="text-slate-200 font-bold block mb-1">Katun Brasil & América Latina:</span>
          Estrutura técnica com estoque local de peças originais, técnicos de aplicação em campo e showroom dedicado em São Paulo.
        </div>
      </div>

      <!-- CMYK Palette Indicators (Square) -->
      <div class="space-y-2 relative z-10">
        <span class="font-['Space_Grotesk',monospace] text-[10px] text-slate-400 font-semibold uppercase block">
          CALIBRAÇÃO DE PROCESSO CMYK KATUN:
        </span>
        <div class="flex gap-3">
          <div class="w-8 h-8 bg-[#00AEEF] border border-white/20 shadow-xs rounded-none" title="Cyan"></div>
          <div class="w-8 h-8 bg-[#E11D48] border border-white/20 shadow-xs rounded-none" title="Magenta"></div>
          <div class="w-8 h-8 bg-[#F59E0B] border border-white/20 shadow-xs rounded-none" title="Yellow"></div>
          <div class="w-8 h-8 bg-slate-950 border border-white/20 shadow-xs rounded-none" title="Black"></div>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('contact-form');
    const statusMsg = document.getElementById('form-status');

    if (form) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        if (statusMsg) {
          statusMsg.classList.remove('hidden');
          form.reset();
          setTimeout(() => {
            statusMsg.classList.add('hidden');
          }, 8000);
        }
      });
    }
  });
</script>
