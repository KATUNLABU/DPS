---
---

<section id="wow-engine" class="relative min-h-[150vh] md:min-h-[220vh] bg-slate-950 text-white my-12 border-y border-slate-800">
  <!-- Sticky Container for Viewport -->
  <div class="sticky top-16 h-[80vh] md:h-[88vh] flex flex-col justify-between p-4 sm:p-8 max-w-7xl mx-auto overflow-hidden">
    
    <!-- Section Header -->
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 z-20">
      <div>
        <span class="font-['Space_Grotesk',monospace] text-xs font-semibold px-3 py-1 bg-[#00aeef]/20 text-[#00aeef] rounded-full border border-[#00aeef]/30 inline-block mb-1">
          DEMO EN VIVO • SCROLL REVEAL
        </span>
        <h2 class="font-['Plus_Jakarta_Sans',sans-serif] text-2xl sm:text-4xl font-extrabold text-white tracking-tight">
          Prensa Digital & Corte Láser en Acción
        </h2>
      </div>

      <!-- Live Telemetry HUD Badge -->
      <div class="flex flex-wrap items-center gap-2 sm:gap-4 bg-slate-900/90 backdrop-blur-md px-3 sm:px-4 py-2 rounded-2xl border border-slate-800 font-['Space_Grotesk',monospace] text-[10px] sm:text-xs shadow-xl">
        <div class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
          <span class="text-slate-300 font-semibold" id="hud-status">ETAPA: 1/4 - SUSTRATO</span>
        </div>
        <div class="h-4 w-px bg-slate-700 hidden sm:block"></div>
        <span class="text-[#00aeef] font-bold" id="hud-dpi">1600 DPI</span>
        <div class="h-4 w-px bg-slate-700 hidden sm:block"></div>
        <span class="text-rose-400 font-bold" id="hud-speed">21 M/MIN</span>
      </div>
    </div>

    <!-- Central Interactive Visual Display Stage -->
    <div class="relative flex-grow my-4 rounded-3xl overflow-hidden border border-slate-800 bg-slate-900 flex items-center justify-center shadow-2xl">
      <!-- Background Image Layer 1: Raw Substrate Film Roll -->
      <div id="layer-substrate" class="absolute inset-0 transition-all duration-700 ease-out opacity-100 scale-100">
        <img 
          src="https://images.unsplash.com/photo-1581092160607-ee22621dd758?auto=format&fit=crop&w=1400&q=80" 
          alt="Sustrato en blanco Katun DPS" 
          class="w-full h-full object-cover brightness-75"
        />
        <div class="absolute inset-0 bg-slate-950/40"></div>
        <div class="absolute top-6 left-6 bg-slate-900/80 backdrop-blur-md px-3.5 py-1.5 rounded-xl border border-slate-700 text-xs font-['Space_Grotesk',monospace] text-slate-300">
          FASE 1: Alimentación de Sustrato (BOPP 350GSM)
        </div>
      </div>

      <!-- Layer 2: CMYK Micro-Ink Deposit -->
      <div id="layer-cmyk" class="absolute inset-0 transition-all duration-700 ease-out opacity-0 scale-95 pointer-events-none">
        <img 
          src="https://images.unsplash.com/photo-1562654501-a0ccc0fc3fb1?auto=format&fit=crop&w=1400&q=80" 
          alt="Inyección CMYK Memjet" 
          class="w-full h-full object-cover saturate-150"
        />
        <div class="absolute inset-0 bg-gradient-to-r from-[#00aeef]/20 via-[#e11d48]/20 to-transparent mix-blend-color"></div>
        
        <!-- Firing Ink Droplets Simulation -->
        <div class="absolute inset-x-0 top-1/3 flex justify-around opacity-80 pointer-events-none">
          <div class="w-1.5 h-16 bg-[#00aeef] rounded-full animate-bounce"></div>
          <div class="w-1.5 h-20 bg-[#e11d48] rounded-full animate-bounce delay-100"></div>
          <div class="w-1.5 h-12 bg-[#f59e0b] rounded-full animate-bounce delay-200"></div>
        </div>

        <div class="absolute top-6 left-6 bg-slate-900/80 backdrop-blur-md px-3.5 py-1.5 rounded-xl border border-[#00aeef]/40 text-xs font-['Space_Grotesk',monospace] text-[#00aeef]">
          FASE 2: Inyección Memjet® CMYK (70,000 boquillas)
        </div>
      </div>

      <!-- Layer 3: UV Varnish Coating Sheen -->
      <div id="layer-varnish" class="absolute inset-0 transition-all duration-700 ease-out opacity-0 scale-95 pointer-events-none">
        <img 
          src="https://images.unsplash.com/photo-1510812431401-41d2bd2722f3?auto=format&fit=crop&w=1400&q=80" 
          alt="Acabado Barniz UV y Brillo" 
          class="w-full h-full object-cover contrast-125"
        />
        <div class="absolute inset-0 bg-gradient-to-tr from-white/10 via-transparent to-white/20 mix-blend-overlay"></div>
        <div class="absolute top-6 left-6 bg-slate-900/80 backdrop-blur-md px-3.5 py-1.5 rounded-xl border border-[#f59e0b]/40 text-xs font-['Space_Grotesk',monospace] text-[#f59e0b]">
          FASE 3: Curado UV LED & Barniz Brillo Protección
        </div>
      </div>

      <!-- Layer 4: Laser CO2 Precision Cut & Finished Label -->
      <div id="layer-laser" class="absolute inset-0 transition-all duration-700 ease-out opacity-0 scale-95 pointer-events-none">
        <img 
          src="https://images.unsplash.com/photo-1504917599217-d4dc5ebe6122?auto=format&fit=crop&w=1400&q=80" 
          alt="Corte láser LC 350 PM" 
          class="w-full h-full object-cover contrast-125"
        />
        <!-- Laser Beam Line -->
        <div class="absolute top-0 bottom-0 left-1/2 w-1 bg-[#e11d48] animate-laser shadow-[0_0_20px_#e11d48]"></div>
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-8 h-8 rounded-full bg-rose-500 blur-sm animate-ping"></div>

        <div class="absolute top-6 left-6 bg-slate-900/80 backdrop-blur-md px-3.5 py-1.5 rounded-xl border border-rose-500/40 text-xs font-['Space_Grotesk',monospace] text-rose-400">
          FASE 4: Troquelado Láser CO2 LC 350 PM (80 m/min)
        </div>
      </div>

      <!-- Floating Indicator Text Overlay -->
      <div class="relative z-10 text-center max-w-xl p-6 bg-slate-950/80 backdrop-blur-md rounded-2xl border border-slate-800 shadow-2xl">
        <span class="font-['Space_Grotesk',monospace] text-xs font-bold text-[#00aeef] uppercase block mb-1" id="stage-badge">
          FASE 1 DE 4
        </span>
        <h3 class="font-['Plus_Jakarta_Sans',sans-serif] text-xl sm:text-2xl font-bold text-white mb-2" id="stage-title">
          1. ALIMENTACIÓN DE SUSTRATO
        </h3>
        <p class="text-xs text-slate-300 font-['Space_Grotesk',monospace] leading-relaxed" id="stage-desc">
          Manejo continuo de bobina con tensión controlada servomotorizada y centrado ultrasónico BST.
        </p>
      </div>
    </div>

    <!-- Stage Navigation Tabs -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 z-20">
      <button data-stage="0" class="stage-nav-btn p-3 rounded-xl bg-slate-900 border border-[#00aeef] text-[#00aeef] font-['Space_Grotesk',monospace] text-xs font-bold text-left transition-all cursor-pointer">
        1. SUSTRATO
      </button>
      <button data-stage="1" class="stage-nav-btn p-3 rounded-xl bg-slate-900/60 border border-slate-800 text-slate-400 font-['Space_Grotesk',monospace] text-xs font-medium text-left transition-all cursor-pointer hover:bg-slate-900">
        2. IMPRESIÓN CMYK
      </button>
      <button data-stage="2" class="stage-nav-btn p-3 rounded-xl bg-slate-900/60 border border-slate-800 text-slate-400 font-['Space_Grotesk',monospace] text-xs font-medium text-left transition-all cursor-pointer hover:bg-slate-900">
        3. BARNIZ UV
      </button>
      <button data-stage="3" class="stage-nav-btn p-3 rounded-xl bg-slate-900/60 border border-slate-800 text-slate-400 font-['Space_Grotesk',monospace] text-xs font-medium text-left transition-all cursor-pointer hover:bg-slate-900">
        4. CORTE LÁSER
      </button>
    </div>
  </div>
</section>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const engineSection = document.getElementById('wow-engine');
    const layerSubstrate = document.getElementById('layer-substrate');
    const layerCmyk = document.getElementById('layer-cmyk');
    const layerVarnish = document.getElementById('layer-varnish');
    const layerLaser = document.getElementById('layer-laser');

    const hudStatus = document.getElementById('hud-status');
    const hudDpi = document.getElementById('hud-dpi');
    const hudSpeed = document.getElementById('hud-speed');

    const stageBadge = document.getElementById('stage-badge');
    const stageTitle = document.getElementById('stage-title');
    const stageDesc = document.getElementById('stage-desc');

    const stageNavBtns = document.querySelectorAll('.stage-nav-btn');

    const STAGES_DATA = [
      {
        badge: "FASE 1 DE 4",
        title: "1. ALIMENTACIÓN DE SUSTRATO",
        desc: "Manejo continuo de bobina con tensión controlada servomotorizada y alineación ultrasónica BST en sustratos de hasta 350GSM.",
        dpi: "1600 DPI",
        speed: "21 M/MIN",
        hud: "ETAPA: 1/4 - SUSTRATO"
      },
      {
        badge: "FASE 2 DE 4",
        title: "2. MICRO-INYECCIÓN CMYK MEMJET®",
        desc: "Inyección a 120kHz con 70,000 boquillas de micro-gota fija de 1.2 picolitros para colores vibrantes e imposición sin marcas.",
        dpi: "2400 DPI MAX",
        speed: "21 M/MIN",
        hud: "ETAPA: 2/4 - INYECCIÓN CMYK"
      },
      {
        badge: "FASE 3 DE 4",
        title: "3. BARNIZADO UV & LAMINACIÓN EN FRÍO",
        desc: "Protección instantánea mediante lámparas UV LED multi-zona o pelado de laminación contra agua, químicos y fricción.",
        dpi: "PROTECCIÓN UV",
        speed: "30 M/MIN",
        hud: "ETAPA: 3/4 - BARNIZ & CURADO"
      },
      {
        badge: "FASE 4 DE 4",
        title: "4. TROQUELADO LÁSER CO2 LC 350 PM",
        desc: "Corte digital galvanométrico de alta potencia (150W). Cambio automático de forma por lectura QR sin placas mecánicas.",
        dpi: "SUBMICRÓNICO",
        speed: "80 M/MIN MAX",
        hud: "ETAPA: 4/4 - CORTE LÁSER 150W"
      }
    ];

    function setStage(index) {
      const layers = [layerSubstrate, layerCmyk, layerVarnish, layerLaser];
      
      layers.forEach((layer, i) => {
        if (i === index) {
          layer.classList.remove('opacity-0', 'scale-95', 'pointer-events-none');
          layer.classList.add('opacity-100', 'scale-100');
        } else {
          layer.classList.remove('opacity-100', 'scale-100');
          layer.classList.add('opacity-0', 'scale-95', 'pointer-events-none');
        }
      });

      const data = STAGES_DATA[index];
      if (data) {
        stageBadge.textContent = data.badge;
        stageTitle.textContent = data.title;
        stageDesc.textContent = data.desc;
        hudStatus.textContent = data.hud;
        hudDpi.textContent = data.dpi;
        hudSpeed.textContent = data.speed;
      }

      stageNavBtns.forEach((btn, i) => {
        if (i === index) {
          btn.className = "stage-nav-btn p-3 rounded-xl bg-slate-900 border border-[#00aeef] text-[#00aeef] font-['Space_Grotesk',monospace] text-xs font-bold text-left transition-all cursor-pointer";
        } else {
          btn.className = "stage-nav-btn p-3 rounded-xl bg-slate-900/60 border border-slate-800 text-slate-400 font-['Space_Grotesk',monospace] text-xs font-medium text-left transition-all cursor-pointer hover:bg-slate-900";
        }
      });
    }

    // Scroll Handler
    function handleScroll() {
      if (!engineSection) return;
      const rect = engineSection.getBoundingClientRect();
      const totalHeight = rect.height - window.innerHeight;
      if (totalHeight <= 0) return;

      const scrolled = -rect.top;
      const progress = Math.max(0, Math.min(1, scrolled / totalHeight));

      let stageIndex = 0;
      if (progress < 0.25) stageIndex = 0;
      else if (progress < 0.50) stageIndex = 1;
      else if (progress < 0.75) stageIndex = 2;
      else stageIndex = 3;

      setStage(stageIndex);
    }

    window.addEventListener('scroll', handleScroll, { passive: true });

    // Button Click Nav
    stageNavBtns.forEach((btn, i) => {
      btn.addEventListener('click', () => {
        setStage(i);
      });
    });
  });
</script>
